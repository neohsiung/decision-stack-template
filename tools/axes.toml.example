# 領域詞彙表。stack init 把這份複製成 tools/axes.toml。實檔記的是這座棧的判斷，不進 template。
#
# 三個鍵掛在 Decisions 與 Expressions 的 frontmatter：
#   field  必填，可多值。這筆判斷屬於哪個領域。「通用」是跨領域的判斷，帶 --field 檢索時永遠放行。
#   area   選填，可多值。這個領域底下的分區。值要在該 field 的 area 表裡。
#   stage  選填。這個領域的工作階段。值要在該 field 的 stage 表裡。
#
# 加值就在表裡加一個字串，加領域就加一段 [field."名字"]，都不用改工具。
# 加之前先問：有沒有兩筆條目因為缺它撞在同一格、寫法卻不同。沒有就先不加，空格不是待辦。
# 刪或改名之後，stack lint 會列出還在用舊值的條目。
#
# 非 ASCII 的鍵要加引號，這是 TOML 的規定。
#
# [org."代碼"] 定義 Expressions 可以掛的組織代碼，traits 寫這個組織的特性。
# 規格句用特性寫條件，不寫組織內部的名字：換到特性相同的下一個組織，條目還用得上。
# 代碼對應的真名只放 tools/local/orgs.tsv，不進版控；lint 會擋真名出現在條目裡。
# 例：
#   [org."C1"]
#   traits = ["跨國團隊", "文件英文為主"]

[field."技術"]
# BE     服務端的邏輯與資料
# FE     瀏覽器端
# APP    行動端
# QA     驗證方法與測試設計
# Infra  執行環境與資源：網路、運算、資料庫維運、成本
# DevOps 從程式碼到上線的管線：建置、部署、發布、監控回饋
# 跨端   不綁任何一端的技術判斷
area = ["BE", "FE", "APP", "QA", "Infra", "DevOps", "跨端"]
stage = ["設計", "實作", "驗證", "交付"]
# role：寫的人在這一格的立場，只掛在 Expressions。寫立場，不寫職稱：職稱屬於組織
role = ["開發者", "技術負責人", "審查者"]

[field."產品"]
[field."管理"]
role = ["主管", "成員"]
[field."專案"]
[field."生活"]
[field."通用"]
