INSTALLED_ROOT_PATH = os.path.join(ROOT, "tools", "context", ".installed-root")
BLOCK_BEGIN = "<!-- decision-stack:begin fragment={frag} sha256={sha} -->"
BLOCK_END = "<!-- decision-stack:end -->"
BLOCK_RE = re.compile(
    r"<!-- decision-stack:begin fragment=(?P<frag>[^\s]+) sha256=(?P<sha>[0-9a-f]+) -->\n"
    r"(?P<body>.*?)\n?" + re.escape(BLOCK_END) + r"\n?", re.DOTALL)


def sha12(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()[:12]


def enclosing_worktree(path):
    """path 所在的 git 工作樹頂層，不在版控樹裡回 None。"""
    d = os.path.dirname(os.path.abspath(path)) or "/"
    try:
        r = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def backup(path):
    dst = f"{path}.bak-{__import__('datetime').datetime.now().strftime('%Y%m%d%H%M')}"
    with open(path, "rb") as src, open(dst, "wb") as out:
        out.write(src.read())
    return dst


def plan_import(target, frag_rel, frag_abs):
    """回傳 (動作, 新內容 or None, 說明)。不認識的區塊內容一律拒絕。"""
    text = open(target, encoding="utf-8").read()
    want_line = f"@{frag_abs}"
    header = BLOCK_BEGIN.format(frag=frag_rel, sha=sha12(frag_abs))
    block = f"{header}\n{want_line}\n{BLOCK_END}\n"
    for m in BLOCK_RE.finditer(text):
        if m.group("frag") != frag_rel:
            continue
        body = m.group("body").strip()
        if body != want_line and not body.startswith("@"):
            return "REFUSED", None, f"區塊內有不認識的內容：{body[:60]!r}"
        if body == want_line and m.group("sha") == sha12(frag_abs):
            return "OK", None, "已接好且 sha256 相符"
        return "UPDATE", text[:m.start()] + block + text[m.end():], \
               f"更新區塊（舊 sha={m.group('sha')}）"
    if want_line in text:
        return "REFUSED", None, "檔案裡已有裸的 @import 行但不在界定區塊內——請先手動移除"
    sep = "" if text.endswith("\n") else "\n"
    return "APPEND", text + sep + "\n" + block, "在檔尾新增區塊"


def plan_instructions(target, frag_abs):
    try:
        data = json.loads(open(target, encoding="utf-8").read())
    except json.JSONDecodeError as e:
        return "REFUSED", None, f"目標不是合法 JSON：{e}"
    items = data.get("instructions")
    if items is None:
        items = []
    if not isinstance(items, list):
        return "REFUSED", None, "instructions 不是陣列"
    for it in items:
        if isinstance(it, str) and os.path.realpath(os.path.expanduser(it)) == frag_abs:
            return "OK", None, "instructions[] 已列到"
    data["instructions"] = items + [frag_abs]
    return "APPEND", json.dumps(data, ensure_ascii=False, indent=2) + "\n", \
           f"append 進 instructions[]（原有 {len(items)} 筆）"


SHIM_DIR = os.path.expanduser("~/.local/bin")
SHIM_PATH = os.path.join(SHIM_DIR, "stack")


def plan_shim(write):
    """讓 `stack` 這個名字在 PATH 上解到本 repo 的 tools/stack。

    這一步消掉一個參數。契約片段裡的檢索指令本來寫絕對路徑，那是每台機器都不同的值，
    而片段是被各 harness 原樣載入的文字。有了 shim，片段寫 `stack recall` 就到處成立。

    不搶名字。已指到別處時回 FAIL。
    """
    target = os.path.join(ROOT, "tools", "stack")
    on_path = SHIM_DIR in os.environ.get("PATH", "").split(os.pathsep)
    tail = "" if on_path else f"　{SHIM_DIR} 不在 PATH 上，請自己加"
    if os.path.islink(SHIM_PATH) or os.path.exists(SHIM_PATH):
        cur = os.path.realpath(SHIM_PATH)
        if cur == os.path.realpath(target):
            return ("OK", "stack shim", f"{SHIM_PATH} → 本 repo{tail}")
        return ("FAIL", "stack shim", f"{SHIM_PATH} 已指向 {cur}。不搶這個名字，請自己決定")
    if not write:
        return ("PLAN", "stack shim", f"建 {SHIM_PATH} → {target}")
    try:
        os.makedirs(SHIM_DIR, exist_ok=True)
        os.symlink(target, SHIM_PATH)
    except OSError as e:
        return ("FAIL", "stack shim", f"建不起來：{e}")
    return ("DONE", "stack shim", f"{SHIM_PATH} → 本 repo{tail}")


def cmd_install(args):
    """依 MANIFEST 接線。寫入前拒絕任何位於其他 git 工作樹內的目標。

    那道拒絕就是公私分界的機械閘門：結構上讓這支工具不可能把個人路徑寫進公司 repo
    的指令檔（那些檔案未被 .gitignore 覆蓋，一次 git add . 就會被 commit 出去）。
    """
    top = (git_out("rev-parse", "--show-toplevel") or "").strip()
    if os.path.realpath(top) != os.path.realpath(ROOT):
        die(f"這棵樹的 git toplevel 是 {top}，而腳本位置推出來的 repo 是 {ROOT}。\n"
            f"  兩者不同代表這是一份複製出來的樹，從這裡安裝會把接線指到錯的地方。\n"
            f"  → 切到 {ROOT} 再跑 install")
    manifest = read_manifest()
    if not manifest:
        die(f"讀不到 tools/context/MANIFEST.tsv，或它沒有任何一列。\n"
            f"  install 靠這份清單決定要接哪些 harness。\n"
            f"  → 確認 {os.path.join(ROOT, 'tools', 'context', 'MANIFEST.tsv')} 在且有內容")

    if os.path.exists(INSTALLED_ROOT_PATH):
        prev = open(INSTALLED_ROOT_PATH, encoding="utf-8").read().strip()
        if prev and os.path.realpath(prev) != os.path.realpath(ROOT) and not args.relocate:
            die(f"上次安裝的 repo 位置是 {prev}，現在是 {ROOT}。"
                "\n  指標是絕對路徑，搬家會一次弄壞所有 harness："
                "\n  → 確認要改指標請加 --relocate")

    wanted = None if args.harness in (None, "all") else \
        {h.strip() for h in args.harness.split(",") if h.strip()}
    write = args.yes and not args.dry_run
    if not write:
        print("[dry-run] 只列計畫，不動任何檔案（要真的寫入請加 --yes）\n")

    # 本機前置：hook 路徑與身分閘門。工具不代跑 ollama pull，也不 commit
    steps = []
    hooks_path = (git_out("config", "core.hooksPath") or "").strip()
    if hooks_path != "tools/hooks":
        if write:
            git_out("config", "core.hooksPath", "tools/hooks")
            steps.append(("DONE", "core.hooksPath", "設為 tools/hooks"))
        else:
            steps.append(("PLAN", "core.hooksPath", f"{hooks_path or '(未設)'} → tools/hooks"))
    else:
        steps.append(("OK", "core.hooksPath", "已是 tools/hooks"))
    if not (git_out("config", "--local", "user.email") or "").strip():
        steps.append(("FAIL", "commit 身分", "repo-local user.email 未設，pre-commit 的身分閘門"
                                             "形同虛設　→ git config user.email <你的個人信箱>"))
    try:
        tags = json.load(urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=5))
        if any(m.get("name", "").split(":")[0] == EMBED_MODEL for m in tags.get("models", [])):
            steps.append(("OK", "Ollama", f"{EMBED_MODEL} 在"))
        else:
            steps.append(("TODO", "Ollama", f"缺模型　→ 請自己跑：ollama pull {EMBED_MODEL}"))
    except (urllib.error.URLError, OSError, json.JSONDecodeError):
        steps.append(("TODO", "Ollama", f"連不上 {OLLAMA_URL}　→ ollama serve 後再跑 stack index"))
    steps.append(plan_shim(write))
    if not os.path.exists(INDEX_PATH):
        steps.append(("TODO", "向量索引", "還沒建立　→ tools/stack index"))
    else:
        steps.append(("OK", "向量索引", "已存在"))

    for level, label, detail in steps:
        print(f"  [{level}] {label}：{detail}")
    print()

    # 逐列接線
    results = []
    for r in manifest:
        harness, primitive = r.get("harness", "?"), r.get("primitive", "")
        frag_rel = r.get("fragment", "")
        label = f"{harness}／{os.path.basename(frag_rel) or '-'}"
        if wanted is not None and harness not in wanted:
            results.append(("SKIP", label, "不在 --harness 指定範圍內"))
            continue
        if primitive == "unwired":
            results.append(("UNWIRED", label, r.get("note") or "宣告的缺口，不接"))
            continue
        if primitive == "inherit":
            results.append(("OK", label, f"繼承自 {r.get('target_path')}，沒有獨立接線點"))
            continue
        frag_abs = os.path.realpath(os.path.join(ROOT, frag_rel))
        if not frag_abs.startswith(os.path.realpath(ROOT) + os.sep) or not os.path.exists(frag_abs):
            results.append(("REFUSED", label, f"片段不在 repo 內或不存在：{frag_rel}"))
            continue
        target = os.path.expanduser(r.get("target_path", ""))
        if not os.path.exists(target):
            results.append(("SKIP", label, f"目標不存在（這台機器沒裝這個 harness）："
                                           f"{r.get('target_path')}"))
            continue
        if os.path.realpath(target) == os.path.realpath(
                os.path.join(CLAUDE_DIR, "settings.json")):
            results.append(("REFUSED", label, "不碰 ~/.claude/settings.json（含明文金鑰）"))
            continue
        wt = enclosing_worktree(target)
        if wt and os.path.realpath(wt) != os.path.realpath(ROOT):
            results.append(("REFUSED", label, f"{r.get('target_path')} 位於版控樹 {wt}，"
                                              "寫入會讓個人路徑變成可 commit 的內容"))
            continue
        if primitive == "import":
            action, new_text, why = plan_import(target, frag_rel, frag_abs)
        elif primitive == "instructions[]":
            action, new_text, why = plan_instructions(target, frag_abs)
        else:
            action, new_text, why = "REFUSED", None, f"不認識的原語 {primitive}"
        if action in ("OK", "REFUSED") or new_text is None:
            results.append((action, label, why))
            continue
        if not write:
            results.append(("PLAN", label, f"{why}（{r.get('target_path')}）"))
            continue
        bak = backup(target)
        with open(target, "w", encoding="utf-8") as f:
            f.write(new_text)
        results.append(("DONE", label, f"{why}；備份 {os.path.basename(bak)}"))

    for level, label, detail in results:
        mark = {"DONE": "✓", "OK": "✓", "PLAN": "·", "SKIP": "—",
                "UNWIRED": "—", "REFUSED": "✗"}.get(level, "?")
        print(f"  {mark} [{level}] {label}：{detail}")

    if write:
        with open(INSTALLED_ROOT_PATH, "w", encoding="utf-8") as f:
            f.write(os.path.realpath(ROOT) + "\n")

    refused = sum(1 for l, _, _ in results if l == "REFUSED")
    print(f"\n接線安裝：{sum(1 for l,_,_ in results if l == 'DONE')} 寫入 ／ "
          f"{sum(1 for l,_,_ in results if l in ('OK',))} 已就位 ／ "
          f"{sum(1 for l,_,_ in results if l in ('PLAN',))} 待寫入 ／ "
          f"{sum(1 for l,_,_ in results if l in ('SKIP',))} 跳過 ／ {refused} 拒絕")
    if not write:
        print("（dry-run 不驗證接線；真的寫入後會自動接著跑 doctor）")
        return 1 if refused else 0
    print("\n--- doctor ---")
    return cmd_doctor(argparse.Namespace(quiet=False, json=False, self_test=False))


def die(msg):
    print(f"stack: {msg}", file=sys.stderr)
    sys.exit(2)


def main():
    p = argparse.ArgumentParser(prog="stack", description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("recall", help="語意檢索 top-k ＋ 一跳連結鄰居")
    r.add_argument("query")
    r.add_argument("-k", type=int, default=5)
    r.add_argument("-q", "--quiet", action="store_true", help="不印重嵌訊息")
    r.add_argument("--no-branches", action="store_true",
                   help="只掃工作目錄，不掃未合併分支（預設會掃）")
    r.add_argument("--stale-ok", action="store_true",
                   help="唯讀：用既有索引比對、不重嵌不寫檔；過期與全新條目明列（計畫模式用）")
    r.set_defaults(func=cmd_recall)

    s = sub.add_parser("shape", help="全量 cluster：收斂候選與拆分候選")
    s.add_argument("--threshold", type=float, default=0.70, help="同群門檻（預設 0.70）")
    s.add_argument("--pairs", type=int, default=15, help="列出最相似的幾對（預設 15）")
    s.add_argument("--split", type=int, default=12, help="列出凝聚度最低的幾筆（預設 12）")
    s.set_defaults(func=cmd_shape)

    l = sub.add_parser("lint", help="索引↔檔案、連結、frontmatter、upstream、詞彙表、索引過期")
    l.add_argument("--strict", action="store_true",
                   help="寫作契約 v2 的三項（首句一句一意／固定分節／related 具名）從提醒升為缺陷")
    l.add_argument("--shippable", action="store_true",
                   help="只掃可升級區：日期、PR 號、版本號、單機用語、第一人稱、連進三層、具名清單")
    l.set_defaults(func=cmd_lint)

    t = sub.add_parser("tree", help="依 upstream 印格狀結構——瀏覽視角；查找走 recall")
    t.set_defaults(func=cmd_tree)

    u = sub.add_parser("usage", help="使用記錄報表：命中統計與淘汰候選（下界訊號）")
    u.add_argument("--window", type=int, default=90, help="淘汰觀察窗天數（預設 90）")
    u.add_argument("--queries", action="store_true",
                   help="改看查詢側：這一輪問了什麼、同一句問了幾遍")
    u.set_defaults(func=cmd_usage)

    ev = sub.add_parser("eval", help="召回率回歸（tools/regression.tsv）")
    ev.add_argument("-k", type=int, default=5, help="次要門檻（預設 top-5）")
    ev.add_argument("--save-baseline", action="store_true", help="把這次結果存成基線（不進版控）")
    ev.set_defaults(func=cmd_eval)

    d = sub.add_parser("doctor", help="接線體檢：規則有沒有真的到得了各 harness（唯讀）")
    d.add_argument("-q", "--quiet", action="store_true", help="只印非 OK 的列")
    d.add_argument("--json", action="store_true", help="機器可讀輸出（給 selfcheck 用）")
    d.add_argument("--self-test", action="store_true",
                   help="負向測試：拿刻意壞掉的 MANIFEST 餵檢查器，它必須抓到")
    d.set_defaults(func=cmd_doctor)

    ins = sub.add_parser("install", help="依 MANIFEST 接線（拒絕寫入任何版控樹內的目標）")
    ins.add_argument("--harness", help="逗號分隔，或 all（預設 all）")
    ins.add_argument("--dry-run", action="store_true", help="只列計畫")
    ins.add_argument("--yes", action="store_true", help="真的寫入（沒有這個旗標等同 dry-run）")
    ins.add_argument("--relocate", action="store_true",
                     help="repo 換過位置，明示要改掉所有指標")
    ins.set_defaults(func=cmd_install)

    ini = sub.add_parser("init", help="建立一個新的決策棧。已存在的檔案不覆蓋")
    ini.set_defaults(func=cmd_init)

    i = sub.add_parser("index", help="強制重建向量索引")
    i.set_defaults(func=cmd_index)

    rt = sub.add_parser("root", help="印 repo root。給腳本與契約片段用，取代寫死路徑")
    rt.set_defaults(func=cmd_root)

    pr = sub.add_parser("prose", help="量一段文字的句子形狀，可以是 repo 之外的檔案")
    pr.add_argument("file", help="要量的檔案")
    pr.set_defaults(func=cmd_prose)

    tr = sub.add_parser("trace", help="查一份計畫或提案裡的留痕行是哪一次檢索留下的")
    tr.add_argument("file", help="要查的檔案，可以在 repo 之外")
    tr.set_defaults(func=cmd_trace)

    cf = sub.add_parser("config", help="印本機設定值。查不到回 1")
    cf.add_argument("key", help="點號分隔，例：mem0.scope")
    cf.set_defaults(func=cmd_config)

    up = sub.add_parser("upgrade", help="把 template 的可升級區拉進一條分支。條目不碰")
    up.add_argument("--remote", default="template", help="template 的 remote 名")
    up.add_argument("--branch", default="main", help="template 的分支")
    up.add_argument("--yes", action="store_true", help="真的開分支並取出；沒有它只列計畫")
    up.set_defaults(func=cmd_upgrade)

    co = sub.add_parser("contribute", help="把可升級區的改動送回 template。私有區一律拒絕")
    co.add_argument("paths", nargs="+", help="要送回去的檔案，repo 相對路徑")
    co.add_argument("--remote", default="template")
    co.add_argument("--branch", default="main")
    co.add_argument("--topic", help="分支主題，用在 contrib/<主題>")
    co.set_defaults(func=cmd_contribute)

    args = p.parse_args()
    # init 要建的正是 assert_repo_root 要找的目錄，所以它在檢查之前跑
    if getattr(args, "func", None) is not cmd_init:
        assert_repo_root()
        # 正常時完全不印。一份天天報錯的檢查會被停止閱讀，然後真正的訊號會跟著
        # 一起被略過——這是 guard-must-cover-every-writer 的直接要求。
        if getattr(args, "cmd", None) in DRIFT_WATCHED:
            for m in baseline_drift():
                print(f"⚠ 基準飄移：{m}", file=sys.stderr)
    sys.exit(args.func(args) or 0)


if __name__ == "__main__":
    main()
