def read_verified():
    """tools/local/verified.tsv → {(harness, fragment): 日期}。檔不在回空 dict。

    驗證日期是本機的證明，跟 MANIFEST 的接線意圖分開存。MANIFEST 進版控、對每台機器
    都一樣；日期不進版控、每台機器一份。
    """
    if not os.path.exists(VERIFIED_PATH):
        return {}
    out = {}
    with open(VERIFIED_PATH, encoding="utf-8") as f:
        for i, line in enumerate(f):
            if i == 0 or not line.strip() or line.startswith("#"):
                continue
            cells = [c.strip() for c in line.rstrip("\n").split("\t")]
            if len(cells) >= 3 and cells[2] not in ("", "-"):
                out[(cells[0], cells[1])] = cells[2]
    return out
CLAUDE_DIR = os.path.expanduser("~/.claude")


def read_manifest(path=MANIFEST_PATH):
    """讀 MANIFEST.tsv → [dict]。找不到檔回 None——「沒有清單」與「清單是空的」要分得開。"""
    if not os.path.exists(path):
        return None
    with open(path, encoding="utf-8") as f:
        lines = [l.rstrip("\n") for l in f if l.strip() and not l.lstrip().startswith("#")]
    if not lines:
        return []
    header = [h.strip() for h in lines[0].split("\t")]
    rows = []
    for line in lines[1:]:
        cells = line.split("\t")
        rows.append({h: (cells[i].strip() if i < len(cells) else "")
                     for i, h in enumerate(header)})
    return rows


def registered_hook_commands(settings_path):
    """settings.json 裡所有 hook 的 command 字串。**只讀不寫**——那個檔含明文金鑰。"""
    try:
        with open(settings_path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError):
        return None
    cmds = []

    def walk(node):
        if isinstance(node, dict):
            if isinstance(node.get("command"), str):
                cmds.append(node["command"])
            for v in node.values():
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)

    walk(data.get("hooks", {}))
    return cmds


def pointer_present(target_abs, primitive, fragment_abs):
    """目標檔裡有沒有指向這個片段的指標。回傳 (found, 說明)。

    原語分開判，因為失效形態不同：import 行是文字（改路徑就靜默失效），
    instructions[] 是 JSON 陣列（壞路徑很可能被該工具靜默忽略）。

    inherit 走的機制與 import 相同，但它沒有自己的接線點——它宣告「這條通道靠繼承上游
    指令檔拿到片段」。機械上查的是同一件事（上游那個檔有沒有 import 行），分成獨立一列
    的理由全在 verified 欄：**上游載入了不等於這條通道也載入了**，那要在該通道自己驗過。
    """
    try:
        text = open(target_abs, encoding="utf-8").read()
    except OSError as e:
        return False, f"讀不到目標：{e}"
    if primitive in ("import", "inherit"):
        for line in text.splitlines():
            line = line.strip()
            if not line.startswith("@"):
                continue
            if os.path.realpath(os.path.expanduser(line[1:].strip())) == fragment_abs:
                return True, ("繼承自上游指令檔，import 行在位"
                              if primitive == "inherit" else "import 行在位")
        return False, "找不到指向這個片段的 @import 行"
    if primitive == "instructions[]":
        try:
            data = json.loads(text)
        except json.JSONDecodeError as e:
            return False, f"目標不是合法 JSON：{e}"
        for item in data.get("instructions") or []:
            if isinstance(item, str) and \
                    os.path.realpath(os.path.expanduser(item)) == fragment_abs:
                return True, "instructions[] 列到了"
        return False, "instructions[] 沒有這個片段"
    return False, f"不認識的原語 {primitive}"


def doctor_manifest_rows(manifest):
    """逐列檢查 MANIFEST。回傳 [(level, 標籤, 說明)]。"""
    rows = []
    verified_local = read_verified()
    if manifest is None:
        return [("FAIL", "MANIFEST", f"找不到 {os.path.relpath(MANIFEST_PATH, ROOT)}")]
    for r in manifest:
        harness = r.get("harness", "?")
        primitive = r.get("primitive", "")
        label = f"{harness}／{os.path.basename(r.get('fragment') or '-')}"
        if primitive == "unwired":
            rows.append(("UNWIRED", harness, r.get("note") or "宣告的缺口"))
            continue
        frag_rel = r.get("fragment", "")
        frag_abs = os.path.realpath(os.path.join(ROOT, frag_rel))
        if not frag_abs.startswith(os.path.realpath(ROOT) + os.sep):
            rows.append(("FAIL", label, f"片段不在本 repo 之下：{frag_rel}"))
            continue
        if not os.path.exists(frag_abs):
            rows.append(("FAIL", label, f"片段不存在：{frag_rel}"))
            continue
        target_abs = os.path.expanduser(r.get("target_path", ""))
        if not os.path.exists(target_abs):
            rows.append(("FAIL", label, f"目標不存在：{r.get('target_path')}"))
            continue
        found, why = pointer_present(target_abs, primitive, frag_abs)
        if not found:
            rows.append(("FAIL", label, f"{why}（{r.get('target_path')}）"))
            continue
        verified = verified_local.get((harness, frag_rel), "")
        if not verified:
            rows.append(("WARN", label, f"{why}，但本機還沒驗過它真的載入。"
                                        "在該 harness 開新 session 請它引用只存在片段裡的一句，"
                                        "引得出再填進 tools/local/verified.tsv"))
        else:
            rows.append(("OK", label, f"{why}，{verified} 驗證過真的載入"))
    return rows


def cmd_doctor(args):
    """接線體檢：純唯讀。回報「規則有沒有真的到得了各 harness」。

    存在的理由：接上了不等於生效，而死接線沒有訊號——`~/.claude/hooks/` 底下就有兩支
    可執行的 hook 腳本註冊在任何 settings 檔裡都找不到，沒有人發現。
    """
    if args.self_test:
        return doctor_self_test()

    rows = []

    # 1. repo 身分與未推送的積欠
    branch = (git_out("rev-parse", "--abbrev-ref", "HEAD") or "?").strip()
    dirty = (git_out("status", "--porcelain") or "").strip()
    rows.append(("INFO", "repo", f"{ROOT}　branch={branch}"
                                 + ("　工作區有未提交變更" if dirty else "　工作區乾淨")))
    unmerged = unmerged_branches()
    if unmerged:
        dated = []
        for b in unmerged:
            d = (git_out("log", "-1", "--format=%ad", "--date=short", b) or "").strip()
            dated.append((d, b))
        dated.sort()
        rows.append(("WARN", "未合併分支",
                     f"{len(dated)} 條待審，最舊 {dated[0][0]}（{dated[0][1]}）"
                     "——數字變大是待辦不是狀態"))
    else:
        rows.append(("OK", "未合併分支", "0 條"))

    # 2. pre-commit 閘門（hook 本體跟著 repo 走，hooksPath 是本機設定）
    hooks_path = (git_out("config", "core.hooksPath") or "").strip()
    hook_file = os.path.join(ROOT, "tools", "hooks", "pre-commit")
    if hooks_path != "tools/hooks":
        rows.append(("FAIL", "pre-commit", f"core.hooksPath={hooks_path or '(未設)'}"
                                           "　→ git config core.hooksPath tools/hooks"))
    elif not os.access(hook_file, os.X_OK):
        rows.append(("FAIL", "pre-commit", "tools/hooks/pre-commit 沒有執行權限"))
    else:
        rows.append(("OK", "pre-commit", "hooksPath=tools/hooks，hook 可執行"))

    # 3. 身分閘門要有 repo-local user.email，否則 pre-commit 擋不了跨身分 commit
    email = (git_out("config", "--local", "user.email") or "").strip()
    rows.append(("OK", "commit 身分", email) if email else
                ("FAIL", "commit 身分", "repo-local user.email 未設，身分閘門形同虛設"))

    # 4. 檢索能力：Ollama 不在是降級不是失效，所以 WARN 不 FAIL
    try:
        tags = json.load(urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=5))
        names = [m.get("name", "") for m in tags.get("models", [])]
        if any(n.split(":")[0] == EMBED_MODEL for n in names):
            rows.append(("OK", "Ollama", f"{OLLAMA_URL}　{EMBED_MODEL} 在"))
        else:
            rows.append(("WARN", "Ollama", f"連上了但沒有 {EMBED_MODEL}"
                                           f"　→ ollama pull {EMBED_MODEL}"))
    except (urllib.error.URLError, OSError, json.JSONDecodeError) as e:
        rows.append(("WARN", "Ollama", f"連不上 {OLLAMA_URL}（{e}）"
                                       "　→ recall 會明確失敗並提示改讀 MEMORY.md"))

    # 5. 索引新鮮度（純衍生物，過期是 recall 自己會修的事）
    entries = load_entries()
    if not os.path.exists(INDEX_PATH):
        rows.append(("WARN", "向量索引", "還沒建立　→ tools/stack index"))
    else:
        try:
            loaded = json.load(open(INDEX_PATH, encoding="utf-8"))
            cached = loaded.get("entries", {}) if loaded.get("schema") == 2 else {}
            stale = [e for e in entries if cached.get(e["relpath"], {}).get("hash") != e["hash"]]
            rows.append(("OK", "向量索引", f"{len(entries)} 筆，過期 {len(stale)} 筆"
                                           "（recall 會自動重嵌）"))
        except (OSError, json.JSONDecodeError):
            rows.append(("WARN", "向量索引", "壞掉，下次 recall 會整份重建"))

    # 6. 逐列 MANIFEST
    rows += doctor_manifest_rows(read_manifest())

    # 7. 死接線對帳：有檔沒註冊 / 有註冊沒檔。兩個方向都要，因為兩種都靜默
    settings = os.path.join(CLAUDE_DIR, "settings.json")
    cmds = registered_hook_commands(settings)
    hook_dir = os.path.join(CLAUDE_DIR, "hooks")
    if cmds is None:
        rows.append(("WARN", "hook 對帳", f"讀不到 {settings}"))
    else:
        joined = "\n".join(cmds)
        if os.path.isdir(hook_dir):
            for fn in sorted(os.listdir(hook_dir)):
                fp = os.path.join(hook_dir, fn)
                if os.path.isfile(fp) and os.access(fp, os.X_OK) and fn not in joined:
                    rows.append(("WARN", "死接線", f"~/.claude/hooks/{fn} 可執行但沒有任何"
                                 f" settings 註冊它。要它生效就在 settings 的 hooks 區加一筆；"
                                 f"不要了就刪掉這個檔，留著會讓下一個人以為它在跑"))
        for c in cmds:
            first = c.split()[0] if c.split() else c
            if first.startswith(("/", "~")) and not os.path.exists(os.path.expanduser(first)):
                rows.append(("FAIL", "死接線", f"settings 註冊了不存在的指令：{first}"))
        guard = os.path.join(ROOT, "tools", "outward-write-guard")
        rows.append(("OK", "外發守衛", "已註冊為 PreToolUse hook") if guard in joined else
                    ("WARN", "外發守衛", "tools/outward-write-guard 沒有被註冊為 PreToolUse "
                     "hook，外發內容不會被攔檢。→ 重跑 tools/stack install --yes"))

    # 工具版本。有接 template remote 就順便比，沒接只報本機
    mine = local_version()
    if git_out("remote", "get-url", "template") is not None:
        theirs = git_out("show", "template/main:tools/VERSION")
        theirs = theirs.strip() if theirs else None
        if theirs is None:
            rows.append(("WARN", "工具版本", f"{mine}　template 那一側讀不到，先 git fetch template"))
        elif theirs != mine:
            rows.append(("WARN", "工具版本", f"{mine}　template 是 {theirs}　→ stack upgrade 看差在哪"))
        else:
            rows.append(("OK", "工具版本", f"{mine}　與 template 相同"))
    else:
        rows.append(("INFO", "工具版本", f"{mine}（沒接 template remote，不比對）"))

    # shim：契約片段寫的是裸名 stack，這條斷了片段就成了死指令
    level, label, detail = plan_shim(write=False)
    rows.append(({"PLAN": "WARN", "DONE": "OK"}.get(level, level), label,
                 detail if level != "PLAN" else detail + "　→ tools/stack install --yes"))

    # 8. 未版控的指令檔：讓「它被改過而我不知道」變成看得見的欄位
    cmd_md = os.path.join(CLAUDE_DIR, "CLAUDE.md")
    if os.path.exists(cmd_md):
        h = hashlib.sha256(open(cmd_md, "rb").read()).hexdigest()[:12]
        mt = __import__("datetime").datetime.fromtimestamp(
            os.path.getmtime(cmd_md)).strftime("%Y-%m-%d %H:%M")
        rows.append(("INFO", "~/.claude/CLAUDE.md",
                     f"{os.path.getsize(cmd_md)} B　mtime={mt}　sha256={h}（未版控）"))

    order = {"FAIL": 0, "WARN": 1, "UNWIRED": 2, "OK": 3, "INFO": 4}
    if args.json:
        print(json.dumps([{"level": l, "label": k, "detail": d} for l, k, d in rows],
                         ensure_ascii=False, indent=2))
    else:
        for level, label, detail in rows:
            if args.quiet and level in ("OK", "INFO"):
                continue
            mark = {"OK": "✓", "WARN": "△", "FAIL": "✗", "UNWIRED": "—", "INFO": "·"}[level]
            print(f"  {mark} {label}：{detail}")

    n = {k: sum(1 for l, _, _ in rows if l == k) for k in order}
    print(f"\n決策棧接線：{n['OK']} OK ／ {n['WARN']} WARN ／ {n['FAIL']} FAIL"
          f" ／ {n['UNWIRED']} UNWIRED(宣告)")
    return 2 if n["FAIL"] else (1 if n["WARN"] else 0)


def doctor_self_test():
    """負向測試：拿一份刻意壞掉的 MANIFEST 餵檢查器，它必須抓到。

    只會綠不會紅的檢查等於沒有檢查——這個 exit code 講的是「測試過不過」，
    不是那份 fixture 健不健康（fixture 當然不健康，那是重點）。
    """
    fixture = os.path.join(ROOT, "tools", "testdata", "doctor", "MANIFEST.tsv")
    if not os.path.exists(fixture):
        print(f"找不到 fixture：{fixture}", file=sys.stderr)
        return 1
    rows = doctor_manifest_rows(read_manifest(fixture))
    for level, label, detail in rows:
        print(f"  [{level}] {label}：{detail}")
    caught = {l for l, _, _ in rows}
    if "FAIL" in caught:
        print("\n負向測試通過：檢查器在壞掉的 MANIFEST 上會紅。")
        return 0
    print("\n負向測試失敗：檢查器抓不到壞掉的 MANIFEST——它現在是恆真的。", file=sys.stderr)
    return 1


