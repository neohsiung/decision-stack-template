def load_cached_vecs():
    """唯讀載入既有索引，不重嵌、不寫檔。回傳 (vecs, 過期清單, 無快取清單)。

    給 --stale-ok 用：計畫模式（禁止改動系統）或趕時間時，寧可用舊向量也不觸發
    幾十分鐘的重嵌。過期與缺席都要明列——靜默地用舊資料，跟靜默地漏資料一樣糟。
    """
    if not os.path.exists(INDEX_PATH):
        return None, [], []
    try:
        with open(INDEX_PATH, encoding="utf-8") as f:
            loaded = json.load(f)
        if loaded.get("schema") != 2 or loaded.get("model") != EMBED_MODEL:
            return None, [], []
    except (json.JSONDecodeError, OSError):
        return None, [], []
    cached = loaded.get("entries", {})
    vecs = {p: [(k, unpack(b)) for k, b in v["views"]] for p, v in cached.items()}
    return vecs, cached, None


def cmd_recall(args):
    entries = load_entries()
    stale_note = ""
    if args.stale_ok:
        vecs, cached, _ = load_cached_vecs()
        if vecs is None:
            die("--stale-ok 需要既有索引；索引不存在或格式不符，改跑 tools/stack index")
        stale = [e["stem"] for e in entries
                 if e["relpath"] in cached and cached[e["relpath"]].get("hash") != e["hash"]]
        missing = [e["stem"] for e in entries if e["relpath"] not in cached]
        entries = [e for e in entries if e["relpath"] in cached]
        parts = []
        if stale:
            parts.append(f"{len(stale)} 筆內容已變、用舊向量比對（{', '.join(stale[:4])}"
                         + ("…" if len(stale) > 4 else "") + "）")
        if missing:
            parts.append(f"{len(missing)} 筆全新、未納入（{', '.join(missing[:4])}"
                         + ("…" if len(missing) > 4 else "") + "）")
        if parts:
            stale_note = "\n  ⚠ 唯讀模式：" + "；".join(parts)
        args.no_branches = True   # 分支條目必然要現嵌，唯讀模式一律跳過
    else:
        vecs = ensure_index(entries, verbose=not args.quiet)

    # 未合併分支上的條目也要進 dedupe 視野（見 load_branch_entries 的 docstring）。
    # 用獨立索引檔，才不會與工作目錄的索引互相淘汰而反覆重嵌。
    branch_entries, branch_note = [], ""
    if not args.no_branches:
        branch_entries = load_branch_entries(entries)
        if branch_entries:
            vecs.update(ensure_index(branch_entries, verbose=not args.quiet,
                                     index_path=BRANCH_INDEX_PATH))
            n_br = len({e["branch"] for e in branch_entries})
            branch_note = f"（含 {len(branch_entries)} 筆來自 {n_br} 條未合併分支）"
        else:
            brs = unmerged_branches()
            if brs:
                branch_note = f"（{len(brs)} 條未合併分支，內容與工作目錄相同）"

    entries = entries + branch_entries
    qvec = embed([args.query])[0]

    scored = []
    for e in entries:
        score, kind = best(qvec, vecs[e["relpath"]])
        scored.append((score, kind, e))
    scored.sort(key=lambda t: -t[0])
    hits = scored[:args.k]
    hit_paths = {e["relpath"] for _, _, e in hits}

    n_views = sum(len(v) for v in vecs.values())
    # 未審有兩個來源，都要標：工作目錄裡尚未進 origin/main 的，與未合併分支上的。
    # 只標其中一種等於讓另一種靜默——那正是這兩個功能各自要防的事。
    unreviewed = unreviewed_paths()
    print(f"掃描 {len(entries)} 筆／{n_views} 個視角{branch_note}，命中 top-{args.k}：\n")
    for score, kind, e in hits:
        if e.get("branch"):
            mark = f"  〔未審 · {e['branch']}〕"
        else:
            mark = "  〔未審〕" if e["relpath"] in unreviewed else ""
        print(f"  {score:.3f}  {e['relpath']}  [{kind}]{mark}")
        print(f"         {e['fm'].get('description', '(無 description)')}")
    n_un = sum(1 for _, _, e in hits
               if e.get("branch") or e["relpath"] in unreviewed)
    if n_un:
        print(f"\n  ⚠ 這次命中有 {n_un} 筆〔未審〕——尚未合進 origin/main，還沒有人看過。"
              f"可以用，但引用時要說它未審。")

    # 一跳連結鄰居：作者手接的連結帶著向量抓不到的關係
    neighbours = []
    for _, _, e in hits:
        for link in e["links"]:
            if link not in hit_paths and link not in neighbours:
                neighbours.append(link)
    if neighbours:
        by_path = {e["relpath"]: e for e in entries}
        print("\n一跳連結鄰居（命中條目自己指向的）：")
        for n in neighbours:
            desc = by_path[n]["fm"].get("description", "") if n in by_path else "！連結指不到"
            print(f"  · {n} — {desc}")

    names = ", ".join(
        os.path.basename(e["relpath"].split("@", 1)[0]) +
        ("〔未審〕" if (e.get("branch") or e["relpath"] in unreviewed) else "")
        for _, _, e in hits)
    # 時戳讓這一行可以被查新鮮度。使用契約說它是唯一能事後看出來的欄位，
    # 但在它帶時戳之前，沒有任何東西查得出它是哪一次檢索留下的。
    import datetime
    _ts = datetime.datetime.now().isoformat(timespec="seconds")
    print(f"\n決策棧檢索：{_ts} 命中 {names}{stale_note}")

    neigh_stems = [by_path[n]["stem"] for n in neighbours
                   if n in by_path] if neighbours else []
    log_usage(args.query, [e["stem"] for _, _, e in hits], neigh_stems)


