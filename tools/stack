USAGE_PATH = os.path.join(ROOT, "tools", ".usage.tsv")


def _session_tag():
    """把同一輪的查詢分在一起用的標籤。只要分得開，不需要跨機器唯一。

    各 harness 的 session 變數名不同，所以列成一張表往下找；STACK_SESSION 是留給
    人手動接的口子，排最前面。都沒有就退回父行程 id。

    取雜湊不取原值：這個欄位的內容由 harness 決定，取雜湊之後不論它塞什麼進來，
    落在 log 裡的都只是一個分組鍵。
    """
    import hashlib
    for var in ("STACK_SESSION", "CLAUDE_CODE_HOST_SESSION_ID", "OPENCODE_SESSION_ID"):
        v = os.environ.get(var)
        if v:
            return hashlib.sha1(v.encode()).hexdigest()[:8]
    return f"p{os.getppid()}"


def log_usage(query, stems, neighbours=()):
    """每次 recall 記一行：日期、查詢、直接命中、鄰居觸及。淘汰判準的機械訊號（§各層契約）。

    **兩欄分開記，因為它們是兩種不同的「被用到」。** 直接命中＝向量檢索撈到；鄰居觸及＝
    命中條目手接的連結把它帶進視野。Model 層常常只走鄰居觸及這一欄。實測過一筆 Model
    直接命中 0 次，卻在同期真的影響了判斷並被追加 confirmed。
    只算 top-k 會系統性低估 Model 層，讓淘汰判準誤殺它們。

    不進版控（查詢會含工作語彙，是去識別化風險；且它是機器本地的事件資料）。
    寫入失敗靜默略過——log 壞掉不可以毀掉檢索。**只寫不讀回排序**：讓使用量回饋
    權重會變成自我強化的人氣模型（Frameworks/agent-memory-design.md 第 3 條）。
    """
    try:
        import datetime
        with open(USAGE_PATH, "a", encoding="utf-8") as f:
            # 新欄位接在最後面，舊列的前四欄位置不動，讀的那一側才不必分版本。
            f.write(f"{datetime.date.today().isoformat()}\t"
                    f"{query[:120].replace(chr(9), ' ')}\t{','.join(stems)}\t"
                    f"{','.join(neighbours)}\t"
                    f"{datetime.datetime.now().isoformat(timespec='seconds')}\t"
                    f"{_session_tag()}\n")
    except OSError:
        pass
    _stamp_last_recall(query)


LAST_RECALL_PATH = os.path.join(ROOT, "tools", ".last-recall")


def _stamp_last_recall(query):
    """記下最近一次 recall 的時間與查詢句，供外發前的檢查點讀。

    跟 .usage.tsv 分開：那份是長期的使用統計，這份是「剛剛有沒有檢索過」的即時狀態，
    只有一行、會被覆蓋。同樣不進版控、寫入失敗靜默略過。
    """
    try:
        import datetime
        with open(LAST_RECALL_PATH, "w", encoding="utf-8") as f:
            f.write(f"{datetime.datetime.now().isoformat(timespec='seconds')}\t"
                    f"{query[:200].replace(chr(9), ' ')}\n")
    except OSError:
        pass


TRACE_RE = re.compile(r"決策棧檢索：(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)?\s*命中")


def cmd_prose(args):
    """量一段文字的句子形狀。輸入可以是 repo 之外的任何檔案。

    寫作契約訂在 WRITING §寫作指南，`lint` 每次都查，但它只查 repo 裡的條目。要離開
    對話的產出（留言、票面、訊息、文件）從來沒有被同一把尺量過，於是它們會停在契約
    寫下之前的狀態。這一支就是那把尺，拿出去用。

    **不給及格與不及格。** 印可數的事實，加上本棧條目的數字當對照線。對照線用現算的，
    不寫死：寫死的常數會跟著條目改寫而過期，而過期的基準比沒有基準更糟。

    刻意不收「括號補充」與「不是X是Y」。量過一批真實的票卡留言，括號裡幾乎全是識別碼、
    `檔名:行號`、日期區間與列舉範圍，是承載訊息的；做成檢查會製造大量誤判，而誤判會讓
    整組訊號被略過。理由與 AI_TELLS 那段註解同源，**是刻意不做，不是漏掉**。
    """
    try:
        with open(args.file, encoding="utf-8", errors="replace") as f:
            body = f.read()
    except OSError as e:
        die(f"讀不到 {args.file}：{e}\n"
            f"  → 確認路徑拼字，或改用絕對路徑。這支指令吃 repo 之外的檔案")
    n, avg, over, dash = prose_stats(body)
    if not n:
        print(f"{args.file}\n  沒有可量的句子（可能整份是程式碼、表格或清單）。")
        return 0
    print(f"{args.file}")
    print(f"  句數 {n}　句均 {avg:.1f} 字　超過 40 字 {over:.1f}%　句中破折號 {dash:.2f}/千字")
    # 40 字這個刻度與下面的對照線都是拿中文條目量出來的。非中文的文字照樣算得出數字，
    # 但那個數字不能跟對照線比：跨語言的差距是語言的差距，不是產出的差距。
    zh = len(re.findall(r"[\u4e00-\u9fff]", prose_body(body)))
    if zh < len(re.sub(r"\s+", "", prose_body(body))) * 0.3:
        print("  這份文字不以中文為主。40 字的刻度與下面的對照線都是拿中文條目量的，"
              "不要跨語言比。")
        return 0

    try:
        entries = load_entries()
    except SystemExit:
        entries = []
    if entries:
        en, eavg, eover, edash = prose_stats("\n".join(e["body"] for e in entries))
        print(f"  對照：這座棧的 {len(entries)} 筆條目 "
              f"句均 {eavg:.1f} 字、超過 40 字 {eover:.1f}%、破折號 {edash:.2f}/千字")
        print(f"  它們都經過 WRITING §寫作指南 的同一份契約。差距大就是契約沒有跟著這份產出走。")
    return 0


def cmd_trace(args):
    """查一份計畫或設計提案裡的留痕行是哪一次檢索留下的。

    使用契約說留痕行由工具產出、偽造不了，是唯一能事後看出來的欄位。缺的是沒有東西
    查它新不新：一份計畫可以大改三輪而那一行不動，它仍然為真，只是早就不是這份計畫
    的檢索紀錄。

    **不給及格與不及格。** 「差幾天算太舊」是判斷，訂一個沒有根據的天數會讓判斷者
    系統性高估（Models/a-criterion-must-terminate.md）。這裡印可數的事實，判斷留給
    讀的人。唯一決定性的結論是留痕行不存在，而那一條使用契約已經寫死：沒有這一行
    等於沒檢索。
    """
    import datetime
    path = args.file
    if not os.path.exists(path):
        print(f"找不到檔案：{path}")
        return 1
    with open(path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    m = TRACE_RE.search(text)
    if not m:
        print(f"{path}\n  ✗ 沒有留痕行。使用契約：沒有這一行等於沒檢索。")
        return 1
    if not m.group(1):
        print(f"{path}\n  留痕行沒有時戳，是舊格式。它證明檢索發生過，但證明不了"
              f"是哪一次。重跑一次 recall 並重貼。")
        return 0

    trace = datetime.datetime.fromisoformat(m.group(1))
    mtime = datetime.datetime.fromtimestamp(os.path.getmtime(path))
    later = 0
    if os.path.exists(USAGE_PATH):
        with open(USAGE_PATH, encoding="utf-8") as f:
            for line in f:
                p = line.rstrip("\n").split("\t")
                if len(p) > 4 and len(p[4]) >= 19:
                    try:
                        later += datetime.datetime.fromisoformat(p[4]) > trace
                    except ValueError:
                        pass

    gap = (mtime - trace).total_seconds() / 3600
    print(f"{path}")
    print(f"  留痕行的檢索時刻  {trace.isoformat(timespec='seconds')}")
    print(f"  檔案最後修改      {mtime.isoformat(timespec='seconds')}")
    print(f"  兩者相差          {gap:.1f} 小時"
          + ("（檔案比留痕舊，那一行是貼進來的舊資料）" if gap < 0 else ""))
    print(f"  該時刻之後的檢索  {later} 次"
          + ("　←　留痕行不是最新的那一次檢索" if later else ""))
    return 0


def cmd_usage_queries():
    """查詢側的視角：這一輪問了什麼、問了幾次、同一句問了幾遍。

    cmd_usage 答的是「哪些條目冷掉了」，那是條目側。這一支答的是「檢索紀律有沒有
    做到」，而在它出現之前這一側完全沒有報告。使用契約的第二個觸發時機（動作成形的
    那一刻）被跳過時不留任何痕跡，跳過十次跟做到十次看起來一樣。

    **只印原文，不判定查詢句是動作句還是主題句。** 那要判斷語意角色，字面比對做不到，
    硬做會產生大量誤判，而誤判會讓整組訊號被略過（guard-must-cover-every-writer）。
    人讀一眼就分得出來。唯一的判定是重複次數，因為它可以數。
    """
    if not os.path.exists(USAGE_PATH):
        print(f"還沒有使用記錄（{USAGE_PATH} 不存在）。recall 每次查詢會自動記一行。")
        return 0
    groups = {}
    with open(USAGE_PATH, encoding="utf-8") as f:
        for line in f:
            p = line.rstrip("\n").split("\t")
            if len(p) < 3:
                continue
            ts = p[4] if len(p) > 4 else ""
            groups.setdefault((p[0], p[5] if len(p) > 5 else ""), []).append((ts, p[1]))

    for (day, sess) in sorted(groups):
        rows = sorted(groups[(day, sess)])
        tag = f"session {sess}" if sess else "session —（舊格式，無時間與 session 欄）"
        print(f"\n{day}  {tag}  {len(rows)} 次")
        for ts, q in rows:
            print(f"  {ts[11:19] if len(ts) >= 19 else '  —  ':>8}  {q}")

        counts = {}
        for _, q in rows:
            counts[q] = counts.get(q, 0) + 1
        rep = sorted(((c, q) for q, c in counts.items() if c >= 3), reverse=True)
        if rep:
            print("  重複 3 次以上：" +
                  "；".join(f"{q}（{c}）" for c, q in rep))
            print("    同一句問這麼多遍，代表 recall 被當成量測儀器在用，不是判斷工具。")

        stamps = [t for t, _ in rows if len(t) >= 19]
        if len(stamps) >= 2:
            import datetime
            ds = sorted(datetime.datetime.fromisoformat(t) for t in stamps)
            gaps = sorted((b - a).total_seconds() / 60 for a, b in zip(ds, ds[1:]))
            print(f"  相鄰兩次間隔中位數：{gaps[len(gaps) // 2]:.0f} 分")

    print("\n判讀方式：查詢句描述的是正要做的動作，還是任務的主題。"
          "\n主題句撈到的是領域原則，動作句才撈得到約束產出形狀的原則"
          "（Decisions/query-the-act-not-the-topic.md）。這一支不替你判，它把原文攤開。")
    return 0


def cmd_usage(args):
    """哪些條目從未被任何檢索情境需要——淘汰候選的下界訊號。

    log 起點之前的缺席不是證據（Decisions/absence-of-signal-is-not-evidence-of-state.md），
    所以覆蓋區間一定印出來；區間太短時零命中不構成候選。
    """
    if getattr(args, "queries", False):
        return cmd_usage_queries()
    entries = load_entries()
    hits, near, first, last = {}, {}, None, None
    if os.path.exists(USAGE_PATH):
        with open(USAGE_PATH, encoding="utf-8") as f:
            for line in f:
                parts = line.rstrip("\n").split("\t")
                # 舊格式 3 欄、之後 4 欄、現在 6 欄。缺的欄位視為空，
                # 不讓既有 log 失效，也不回填：舊列寫下的那一刻沒有這兩欄，回填是捏造。
                if len(parts) < 3:
                    continue
                day, _, stems = parts[0], parts[1], parts[2]
                neigh = parts[3] if len(parts) == 4 else ""
                first, last = first or day, day
                for bucket, field in ((hits, stems), (near, neigh)):
                    for s in field.split(","):
                        if s:
                            rec = bucket.setdefault(s, [0, day])
                            rec[0] += 1
                            rec[1] = day
    if not first:
        print(f"還沒有使用記錄（{USAGE_PATH} 不存在或為空）。recall 每次查詢會自動記一行。")
        return 0

    import datetime
    span = (datetime.date.fromisoformat(last) - datetime.date.fromisoformat(first)).days + 1
    print(f"log 覆蓋 {first} ～ {last}（{span} 天）、"
          f"直接命中 {sum(c for c, _ in hits.values())} 次、"
          f"鄰居觸及 {sum(c for c, _ in near.values())} 次\n")

    def both(e):
        h = hits.get(e["stem"], [0, "—"])
        n = near.get(e["stem"], [0, "—"])
        last_seen = max(d for d in (h[1], n[1]) if d != "—") if (h[0] or n[0]) else "—"
        return h[0], n[0], last_seen

    rows = sorted(((*both(e), e) for e in entries),
                  key=lambda t: (t[0] + t[1], t[0], t[3]["relpath"]))
    print(f"  {'直接':>4}  {'鄰居':>4}  {'最後觸及':>10}  條目")
    for h, n, lastday, e in rows:
        print(f"  {h:>4}  {n:>4}  {lastday:>10}  {e['relpath']}")

    # 淘汰候選＝兩欄都零。只看直接命中會誤殺主要靠連結被帶進視野的 Model 層。
    zero = [e for h, n, _, e in rows if h == 0 and n == 0 and not e["fm"].get("confirmed")]
    print(f"\n直接與鄰居皆零、且無 confirmed：{len(zero)} 筆")
    if span < args.window:
        print(f"  log 覆蓋僅 {span} 天 < 觀察窗 {args.window} 天——**還不構成淘汰候選**，"
              f"缺席要累積夠久才是訊號。")
    elif zero:
        print(f"  覆蓋已滿 {args.window} 天，以下是淘汰候選（人工判準見 SPEC §各層契約·淘汰）：")
        for e in zero:
            print(f"  · {e['relpath']} — {e['fm'].get('description', '')[:60]}")
    return 0


def cmd_tree(args):
    """依 upstream 印格狀結構——Model 為根、Framework 居中、Decision 為葉。

    多親條目在每個親底下都出現並標 ⊕（格狀是多對多，樹只是它的一種攤法）。
    這是瀏覽視角；查找走 recall，資料夾維持扁平（SPEC §各層契約）。
    """
    entries = load_entries()
    children = {}
    for e in entries:
        for u in e["upstream"]:
            children.setdefault(u, []).append(e)

    def line(e, depth):
        multi = " ⊕" if len(e["upstream"]) > 1 else ""
        print("    " * depth + f"[{e['layer'][0]}] {e['stem']}{multi}")

    def walk(path, depth):
        for c in sorted(children.get(path, []), key=lambda x: (x["layer"], x["stem"])):
            line(c, depth)
            walk(c["relpath"], depth + 1)

    for m in sorted((e for e in entries if e["layer"] == "Models"), key=lambda x: x["stem"]):
        print(f"[M] {m['stem']}")
        walk(m["relpath"], 1)

    orphan_f = sorted((e for e in entries if e["layer"] == "Frameworks" and not e["upstream"]),
                      key=lambda x: x["stem"])
    orphan_d = sorted((e for e in entries if e["layer"] == "Decisions" and not e["upstream"]),
                      key=lambda x: x["stem"])
    if orphan_f:
        print(f"\n未接基準的 Frameworks（缺口 {len(orphan_f)} 筆）：")
        for f in orphan_f:
            print(f"[F] {f['stem']}")
            walk(f["relpath"], 1)
    if orphan_d:
        print(f"\n未接基準的 Decisions（缺口 {len(orphan_d)} 筆）：")
        for d in orphan_d:
            print(f"  [D] {d['stem']}")

    n_multi = sum(1 for e in entries if len(e["upstream"]) > 1)
    print(f"\n{len(entries)} 筆；⊕ 多親 {n_multi} 筆（在每個親下都出現一次）")
    return 0


def claim_sims(entries, vecs):
    """條目兩兩的主張相似度。只比 claim 視角——例子像不構成該合併。"""
    claims = {e["relpath"]: [v for k, v in vecs[e["relpath"]] if k == "claim"] or
                            [v for _, v in vecs[e["relpath"]]] for e in entries}
    paths = [e["relpath"] for e in entries]
    sims = {}
    for i in range(len(paths)):
        for j in range(i + 1, len(paths)):
            sims[(i, j)] = max(dot(a, b) for a in claims[paths[i]] for b in claims[paths[j]])
    return paths, sims


def ancestor_map(entries):
    """每筆條目沿 upstream 遞移展開的祖先集合（多對多，深度上限防環）。"""
    up = {e["relpath"]: list(e["upstream"]) for e in entries}
    anc = {}

    def walk(rp, depth=0):
        if rp in anc:
            return anc[rp]
        if depth > 6:
            return set()
        s = set()
        for p in up.get(rp, []):
            s.add(p)
            s |= walk(p, depth + 1)
        if depth == 0:
            anc[rp] = s
        return s

    for rp in up:
        walk(rp)
    return anc


def kinship(a, b, anc):
    """兩筆條目的族譜關係：父子/祖孫、兄弟（共上游），或 None（無關係）。

    存在理由：上下游本來就語意相近——一筆 Decision 是它上游骨架的實例，向量距離當然近。
    收斂候選若不扣掉族譜對，三層結構越完整、假陽性越多。實測過一輪，候選幾乎全是刻意建的
    父子或兄弟，門檻等於失去診斷力。真正要看的是「很像卻沒有族譜關係」。
    """
    aa, ab = anc.get(a, set()), anc.get(b, set())
    if b in aa or a in ab:
        return "父子"
    shared = aa & ab
    if shared:
        return "兄弟"
    return None


def cmd_shape(args):
    entries = load_entries()
    vecs = ensure_index(entries, verbose=True)
    paths, sims = claim_sims(entries, vecs)
    n = len(paths)
    by_path = {e["relpath"]: e for e in entries}

    anc = ancestor_map(entries)
    parent = list(range(n))

    def find(i):
        while parent[i] != i:
            parent[i] = parent[parent[i]]
            i = parent[i]
        return i

    for (i, j), s in sims.items():
        if s >= args.threshold and kinship(paths[i], paths[j], anc) is None:
            a, b = find(i), find(j)
            if a != b:
                parent[a] = b

    clusters = {}
    for i in range(n):
        clusters.setdefault(find(i), []).append(i)
    multi = sorted([c for c in clusters.values() if len(c) > 1], key=len, reverse=True)

    print(f"\n=== 收斂候選：最相似的 {args.pairs} 對（門檻 {args.threshold}）===")
    print("兩筆很近＝同一個檢索情境會同時命中 → 該合併成一筆，或抽一筆上游模型出來")
    print("**已有族譜關係的對不算候選**——上下游與兄弟本來就該相近，那是結構不是缺陷；")
    print("要看的是標 ★ 的那些：很像、卻沒有任何族譜關係。\n")
    n_kin = 0
    for (i, j), s in sorted(sims.items(), key=lambda t: -t[1])[:args.pairs]:
        rel = kinship(paths[i], paths[j], anc)
        if rel:
            n_kin += 1
            flag = f"  （{rel}，非候選）"
        else:
            flag = "  ★ 收斂候選" if s >= args.threshold else ""
        print(f"  {s:.3f}  {by_path[paths[i]]['stem']}")
        print(f"         {by_path[paths[j]]['stem']}{flag}")
    print(f"\n  列出 {args.pairs} 對中 {n_kin} 對有族譜關係（已被結構解釋），"
          f"{args.pairs - n_kin} 對待判。")

    print(f"\n=== 群（門檻 {args.threshold} 以上連通）===")
    if not multi:
        print("  無。全部條目在此門檻下彼此獨立——若預期該有群，把門檻調低再跑一次。")
    for c in multi:
        inner = [sims[(min(a, b), max(a, b))] for a in c for b in c if a < b]
        print(f"\n  群大小 {len(c)}，群內平均 {sum(inner) / len(inner):.3f}：")
        for i in c:
            print(f"    · {paths[i]}")

    # 拆分候選用「內在凝聚度」——一筆條目自己的視角彼此有多像。低＝它自己的段落在講不同的
    # 東西＝混了多個關注點＝SRP 違反。這是內在度量，不依賴分群結果。
    #
    # 「近鄰跨兩群」不能當偵測器：門檻之下幾乎每筆都自成一群，條件變成恆真，
    # 標出絕大多數條目。一個標記幾乎所有東西的檢查等於沒有檢查。
    print("\n=== 拆分候選：內在凝聚度最低的幾筆 ===")
    print("一筆自己的段落彼此不像＝它同時服務多個檢索情境 → SRP 判準說該拆")
    print("讀法：Frameworks 天生就是並列教訓，低凝聚度屬正常；**Models／Decisions 低就是缺陷**，")
    print("而視角數異常多又凝聚度低的，是「好幾份東西擠在一個檔」而不是「一份有很多段」。\n")
    rows = []
    for e in entries:
        vs = [v for _, v in vecs[e["relpath"]]]
        if len(vs) < 3:
            continue
        pairs = [dot(vs[i], vs[j]) for i in range(len(vs)) for j in range(i + 1, len(vs))]
        rows.append((sum(pairs) / len(pairs), min(pairs), len(vs), e))
    rows.sort()
    print(f"  {'平均':>6}{'最低':>7}{'視角':>5}  條目")
    for mean, lo, nv, e in rows[:args.split]:
        print(f"  {mean:>6.3f}{lo:>7.3f}{nv:>5}  {e['relpath']}")
    if rows:
        print(f"\n  （對照：凝聚度最高的是 {rows[-1][3]['stem']} {rows[-1][0]:.3f}——單一主張長這樣）")


# 受去個人化檢查的散文。這裡的每一句都要換一台機器、換一個人仍成立。
# 實際受檢的範圍是這一組與 UPGRADABLE_GLOBS 的聯集，見 shippable_files()。
SHIPPABLE_GLOBS = ["README.md", "README.en.md", "SPEC.md", "WRITING.md", "examples/*.md", "tools/stack", "tools/outward-write-guard", "tools/hooks/*",
                   "tools/context/*.md", "tools/context/MANIFEST.tsv", "skills/*/*.md",
                   "tools/local.example/*", "tools/stack.config.toml.example",
                   "templates/*.md", "CONTRIBUTING.md", "CODE_OF_CONDUCT.md", "LICENSE",
                   ".github/*.md", ".github/ISSUE_TEMPLATE/*"]
# 只對一個時點或一台機器成立的句子會用到的字。命中就擋。
SHIP_FAIL = [
    (r"\b20\d\d-\d\d-\d\d\b", "日期"),
    (r"(?<![\w#])#\d{2,}\b", "PR 號"),
    (r"\bv\d+\.\d+\b", "版本號"),
    (r"這台", "這台"), (r"曾", "曾"), (r"當時", "當時"),
    (r"上次", "上次"), (r"前一次", "前一次"), (r"已知的", "已知的"),
    (r"(?<!自)我", "第一人稱"),   # 排除「自我」
    (r"\]\((?:\.\./)*(?:Models|Frameworks|Decisions|Expressions)/[^)]+\.md", "連進條目"),
]
SHIP_WARN = [(r"目前", "目前"), (r"自己", "自己")]


def shippable_files():
    """受去個人化檢查的檔案＝這一組 glob 加上可升級區的全部。

    **會被發布的一定要受檢，這是不變量。** 分成兩組 glob 是因為它們回答不同的問題：
    這一組問「哪些散文要受檢」，UPGRADABLE_GLOBS 問「哪些檔案的擁有者是 template」。
    問題不同，但答案不能讓前者小於後者。

    取聯集而不是各自維護，理由是實測：發布第一版時可升級區有 41 檔，而這一組只涵蓋
    35 檔。ci.yml、兩個 .gitignore、VERSION 與兩個 testdata 檔會被複製給別人，卻從來
    沒有被檢查過。那一次靠人逐檔讀完才敢推，而人讀不是可重複的保障。

    聯集之後，往可升級區加一個 glob 就自動進入檢查範圍，兩份清單不會再分歧。
    """
    import glob
    out = set()
    for g in list(SHIPPABLE_GLOBS) + list(UPGRADABLE_GLOBS):
        for path in glob.glob(os.path.join(ROOT, g)):
            if os.path.isfile(path):
                out.add(os.path.relpath(path, ROOT))
    return sorted(out)


def read_denylist():
    if not os.path.exists(DENYLIST_PATH):
        return []
    with open(DENYLIST_PATH, encoding="utf-8") as f:
        return [l.strip() for l in f if l.strip() and not l.startswith("#")]


def shippable_scan():
    """回傳 (fails, warns)，每項 (相對路徑, 行號, 類別, 該行片段)。

    引號內與程式碼區塊不掃：引號裡是被引述的例子，不是這句話自己在說。
    """
    fails, warns = [], []
    deny = read_denylist()
    for rel in shippable_files():
        with open(os.path.join(ROOT, rel), encoding="utf-8", errors="replace") as f:
            lines = f.read().split("\n")
        in_code = False
        for i, raw in enumerate(lines, 1):
            if raw.strip().startswith("```"):
                in_code = not in_code
                continue
            if in_code:
                continue
            line = re.sub(r"「[^」]*」", "「」", raw)
            line = re.sub(r'"[^"]*"', '""', line)
            snippet = raw.strip()[:60]
            # recorded: 與 confirmed: 的值照定義就是日期，不是散文裡會過期的時間快照。
            # 日期規則要擋的是後者。這兩個結構欄位跳過日期那一條，其餘照查。
            fm_date = re.match(r"\s*(recorded|confirmed):", line)
            for pat, kind in SHIP_FAIL:
                if kind == "日期" and fm_date:
                    continue
                if re.search(pat, line):
                    fails.append((rel, i, kind, snippet))
                    break
            else:
                for pat, kind in SHIP_WARN:
                    if re.search(pat, line):
                        warns.append((rel, i, kind, snippet))
                        break
            for pat in deny:
                if re.search(pat, raw):
                    fails.append((rel, i, "具名清單", snippet))
                    break
    return fails, warns


