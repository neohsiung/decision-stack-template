def cmd_lint_shippable():
    fails, warns = shippable_scan()
    by_file = {}
    for rel, i, kind, snip in fails:
        by_file.setdefault(rel, []).append((i, kind, snip))
    for rel in shippable_files():
        hits = by_file.get(rel, [])
        w = sum(1 for r, *_ in warns if r == rel)
        mark = "✗" if hits else ("△" if w else "✓")
        print(f"  {mark} {rel}：{len(hits)} 擋／{w} 提醒")
        for i, kind, snip in hits[:8]:
            print(f"      L{i} [{kind}] {snip}")
        if len(hits) > 8:
            print(f"      … 另 {len(hits) - 8} 處")
    print(f"\n可升級區檢查：{len(fails)} 擋／{len(warns)} 提醒，"
          f"共 {len(shippable_files())} 檔。判準：換一台機器、換一個人，這句話還成立嗎。")
    return 1 if fails else 0


def cmd_lint(args):
    if getattr(args, "shippable", False):
        return cmd_lint_shippable()
    entries = load_entries()
    problems = []
    # notices 與 problems 分開：索引類訊息講的是不進版控、會自己痊癒的衍生物，
    # 不是內容缺陷。混在一起會讓 pre-commit 閘門對無缺陷的狀態亮紅燈，而假陽性的閘門
    # 會被繞過（--no-verify），那比沒有閘門糟。
    notices = []
    live = {e["relpath"] for e in entries}

    # 1. 索引 ↔ 檔案雙向一致。沒進索引等於這條原則不存在。
    listed = memory_index_paths()
    for p in listed:
        if p not in live:
            problems.append(f"MEMORY.md 指到不存在的檔案：{p}")
    for p in sorted(live - set(listed)):
        problems.append(f"檔案不在 MEMORY.md 索引裡（等於不存在）：{p}")
    for p in sorted({x for x in listed if listed.count(x) > 1}):
        problems.append(f"MEMORY.md 重複列出：{p}")

    # 2. frontmatter 與規則句
    for e in entries:
        fm = e["fm"]
        for field in REQUIRED_FIELDS:
            if not fm.get(field):
                problems.append(f"{e['relpath']}：缺 frontmatter `{field}`")
        if fm.get("name") and fm["name"] != e["stem"]:
            problems.append(f"{e['relpath']}：name `{fm['name']}` 與檔名不符")
        expected = SCAN_DIRS[e["layer"]]
        if fm.get("type") and fm["type"] != expected:
            problems.append(f"{e['relpath']}：type `{fm['type']}` 與資料夾不符（應為 `{expected}`）")
        if e["layer"] == EXPRESSIONS:
            # 軸是組織鍵：管 lint、管索引分組、管矩陣看得出哪一格沒填。檢索走 description。
            for axis, vocab in EXPRESSION_AXES.items():
                val = fm.get(axis, "").strip()
                if not val:
                    problems.append(f"{e['relpath']}：缺 frontmatter `{axis}`（軸定位它在哪一格）")
                elif val not in vocab:
                    problems.append(f"{e['relpath']}：`{axis}: {val}` 不在受控詞彙"
                                    f"（{'／'.join(vocab)}）")
        if not first_rule(e["body"]):
            problems.append(f"{e['relpath']}：正文沒有粗體規則句（檢索比對的就是這句）")

    # 2b. 寫作契約 v2：首句一句一意、每層固定分節、related 具名。
    # 舊條目還沒改寫完之前這三項只提醒；--strict 才擋。改寫完後 pre-commit 改用 --strict。
    strict = getattr(args, "strict", False)
    sink = problems if strict else notices
    bad_rule, bad_sections, legacy_related, dense = [], [], [], []
    tells = {}
    for e in entries:
        rule = first_rule(e["body"])
        if rule and any(t in rule for t in RULE_FORBIDDEN):
            bad_rule.append(e["relpath"])
        want = SECTIONS[e["layer"]]
        have = entry_sections(e["body"])
        if have[:len(want)] != want:
            bad_sections.append(e["relpath"])
        if re.search(r"\n\s*(?:相關|延伸|參見)[：:]", e["body"]):
            legacy_related.append(e["relpath"])
        d, a = density(e["body"])
        if d > DENSITY_MID_DASH_PER_K or a > DENSITY_AVG_SENTENCE:
            dense.append((e["relpath"], d, a))
        for name, n in ai_tells(e["body"]):
            tells.setdefault(name, []).append((e["relpath"], n))
    if bad_rule:
        sink.append(f"首句規則句含接續記號（——／；／：），一句要只講一個意思：{len(bad_rule)} 筆"
                    + ("" if strict else f"，例：{'、'.join(bad_rule[:3])}"))
        if strict:
            problems.extend(f"{p}：首句含接續記號" for p in bad_rule)
    if bad_sections:
        sink.append(f"分節不符該層固定順序：{len(bad_sections)} 筆"
                    + ("" if strict else f"，例：{'、'.join(bad_sections[:3])}"))
        if strict:
            problems.extend(f"{p}：分節不符 {SECTIONS[p.split('/')[0]]}" for p in bad_sections)
    if legacy_related:
        sink.append(f"正文仍有「相關：」段，要搬到 frontmatter related:：{len(legacy_related)} 筆")
        if strict:
            problems.extend(f"{p}：正文仍有「相關：」段" for p in legacy_related)
    if dense:
        dense.sort(key=lambda t: -(t[1] / DENSITY_MID_DASH_PER_K + t[2] / DENSITY_AVG_SENTENCE))
        notices.append(f"密度警訊（句中破折號>{DENSITY_MID_DASH_PER_K}/千 或 句均>"
                       f"{DENSITY_AVG_SENTENCE}）：{len(dense)} 筆，最高："
                       + "；".join(f"{p}（{d:.1f}／{a:.0f}）" for p, d, a in dense[:3]))
    for name in sorted(tells):
        hits = sorted(tells[name], key=lambda t: -t[1])
        total = sum(n for _, n in hits)
        tail = "（這個形式常常就是主張本身，讀過再決定）" if name == "不是X是Y" else ""
        notices.append(f"AI 語標記「{name}」：{total} 次／{len(hits)} 筆{tail}，最多："
                       + "；".join(f"{p}（{n}）" for p, n in hits[:3]))
    # related 目標一律要解得到——這是新欄位，沒有舊資料要遷，直接當缺陷
    for e in entries:
        for target, note in e["related"]:
            if not resolve_entry_ref(target, live):
                problems.append(f"{e['relpath']}：related 指不到 {target}")
            # 分界句是 related 存在的理由：沒有它就只是一條沒說明為什麼的連結。
            # 格式只要求 `—` 後面有字。分號不是要件，句號或逗號分界一樣算數。
            elif not note:
                problems.append(f"{e['relpath']}：related {target} 缺分界句")

    # 3. 條目間連結解析得到
    for e in entries:
        for link in e["links"]:
            if link not in live and not os.path.exists(os.path.join(ROOT, link)):
                problems.append(f"{e['relpath']}：連結指不到 {link}")

    # 4. 上行格狀結構：方向嚴格向上、目標存在。覆蓋率是缺口報告不是錯誤——
    #    目標形狀是每筆 Decision 有 Framework/Model、每筆 Framework 有 Model，逐輪收斂補齊。
    rank = {"Models": 0, "Frameworks": 1, "Decisions": 2}
    for e in entries:
        for u in e["upstream"]:
            if u not in live:
                problems.append(f"{e['relpath']}：upstream 指不到 {u}")
                continue
            ulayer = u.split("/", 1)[0]
            if e["layer"] not in rank:
                # Expressions 不在推導鏈上，沒有「更上游的層」可比。它的 upstream 是選填的
                # 出處標註：這個形狀是依據哪條判斷來的。只要求指進三層。
                if ulayer not in rank:
                    problems.append(f"{e['relpath']}：upstream {u} 要指進三層")
                continue
            if rank[ulayer] >= rank[e["layer"]]:
                problems.append(f"{e['relpath']}：upstream {u} 不是更上游的層（方向必須嚴格向上）")
        if e["layer"] == "Models" and e["upstream"]:
            problems.append(f"{e['relpath']}：Models 條目不設 upstream（它就是最上游）")

    # 5. 詞彙表雙向一致。單向的索引會靜默漂移——正是 source-migration-downstream-drift
    #    那種失效，所以兩個方向都機械比對：用了沒列 → 補「棧內引用」；列了沒用 → 清單過期。
    sections = glossary_sections()
    usages = glossary_usages()
    for anchor in sorted(set(usages) - set(sections)):
        problems.append(f"GLOSSARY.md 沒有錨點 #{anchor}，但這些檔連過去："
                        + ", ".join(sorted(usages[anchor])))
    for anchor, sec in sections.items():
        used, listed_refs = usages.get(anchor, set()), set(sec["backrefs"])
        for p in sorted(used - listed_refs):
            problems.append(f"GLOSSARY.md #{anchor}：{p} 有連過來但「棧內引用」沒列")
        for p in sorted(listed_refs - used):
            problems.append(f"GLOSSARY.md #{anchor}：「棧內引用」列了 {p} 但該檔沒有連過來")
        if not sec["backrefs"]:
            problems.append(f"GLOSSARY.md #{anchor}：缺「棧內引用」清單（沒人引用的術語該移除）")

    # 6. MANIFEST 指到的片段要存在。純 repo 內部檢查——機器層的接線狀態放在 doctor，
    #    放這裡會讓「這台機器還沒接線」在 pre-commit 亮紅燈，假紅會養出 --no-verify。
    manifest = read_manifest()
    if manifest:
        for r in manifest:
            frag = r.get("fragment", "")
            if r.get("primitive") == "unwired" or frag in ("", "-"):
                continue
            if not os.path.exists(os.path.join(ROOT, frag)):
                problems.append(f"MANIFEST.tsv 指到不存在的片段：{frag}（{r.get('harness')}）")

    # 7. 索引過期（靜默失效，所以要主動報）
    if os.path.exists(INDEX_PATH):
        try:
            with open(INDEX_PATH, encoding="utf-8") as f:
                loaded = json.load(f)
            if loaded.get("schema") != 2:
                notices.append("索引是舊格式，下次 recall 會整份重建")
            else:
                cached = loaded.get("entries", {})
                stale = [e["relpath"] for e in entries
                         if cached.get(e["relpath"], {}).get("hash") != e["hash"]]
                if stale:
                    notices.append(f"向量索引過期 {len(stale)} 筆（recall 會自動重嵌）："
                                    + ", ".join(stale[:5]) + ("…" if len(stale) > 5 else ""))
        except (json.JSONDecodeError, OSError):
            notices.append("向量索引壞掉，下次 recall 會整份重建")
    else:
        notices.append("向量索引還沒建立（跑 stack index）")

    counts = {layer: sum(1 for e in entries if e["layer"] == layer) for layer in SCAN_DIRS
              if any(e["layer"] == layer for e in entries)}
    print(f"條目 {len(entries)} 筆（" + "／".join(f"{k} {v}" for k, v in counts.items())
          + f"），視角 {sum(len(e['views']) for e in entries)} 個"
          + f"，交叉連結 {sum(len(e['links']) for e in entries)} 條"
          + f"，詞彙表 {len(sections)} 詞")

    # 上行覆蓋率（缺口報告）：孤兒不是錯誤，是下一輪收斂的原料
    for layer in ("Decisions", "Frameworks"):
        pool = [e for e in entries if e["layer"] == layer]
        have = [e for e in pool if e["upstream"]]
        orphans = [e["stem"] for e in pool if not e["upstream"]]
        print(f"upstream 覆蓋：{layer} {len(have)}/{len(pool)}"
              + (f"　缺口：{', '.join(orphans[:6])}" + ("…" if len(orphans) > 6 else "")
                 if orphans else "　（全連）"))

    if notices:
        print()
        for n in notices:
            print(f"  · {n}")

    if problems:
        print(f"\n發現 {len(problems)} 個問題：")
        for p in problems:
            print(f"  ✗ {p}")
        hints = [h for sig, h in FIX_HINTS if any(sig in p for p in problems)]
        if hints:
            print("\n怎麼修：")
            for h in hints:
                print(f"  → {h}")
        return 1
    print("全綠。")
    return 0


def cmd_eval(args):
    """召回率回歸。這是唯一能證明工具沒有偷偷變差的東西——改嵌入、換模型、大批拆分後都要跑。"""
    path = os.path.join(ROOT, "tools", "regression.tsv")
    cases = []
    if not os.path.exists(path):
        print(f"這台安裝沒有回歸語料（{os.path.relpath(path, ROOT)} 不在）。eval 不適用。")
        return 0
    with open(path, encoding="utf-8") as f:
        for line in f:
            if line.startswith("#") or "\t" not in line:
                continue
            q, expect = line.rstrip("\n").split("\t", 1)
            cases.append((q, [x.strip() for x in expect.split(",") if x.strip()]))

    if not cases:
        print("回歸語料裡沒有題目。eval 不適用。題目怎麼加見該檔檔頭。")
        return 0
    entries = load_entries()
    vecs = ensure_index(entries, verbose=True)
    ranks, worst = [], []
    for query, expected in cases:
        qvec = embed([query])[0]
        order = sorted(((best(qvec, vecs[e["relpath"]])[0], e) for e in entries),
                       key=lambda t: -t[0])
        stems = [e["stem"] for _, e in order]
        for exp in expected:
            r = stems.index(exp) + 1 if exp in stems else 999
            ranks.append(r)
            mark = "✓" if r <= 3 else ("△" if r <= args.k else "✗")
            print(f"  {mark} rank {r:>3}  {exp}")
            if r > 3:
                worst.append((r, exp, query))
    top3 = sum(1 for r in ranks if r <= 3)
    topk = sum(1 for r in ranks if r <= args.k)
    avg = sum(ranks) / len(ranks)
    print(f"\ntop-3 命中 {top3}/{len(ranks)}　top-{args.k} 命中 {topk}/{len(ranks)}"
          f"　平均 rank {avg:.1f}")
    # 基線存檔、不抄進文件。抄進散文的數字會跟實際值分岔。
    if os.path.exists(EVAL_BASELINE_PATH):
        try:
            b = json.load(open(EVAL_BASELINE_PATH, encoding="utf-8"))
            print(f"基線（{b.get('date')}，{b.get('entries')} 筆）：top-3 {b.get('top3')}/{b.get('n')}"
                  f"　top-{args.k} {b.get('topk')}/{b.get('n')}　平均 rank {b.get('avg')}")
        except (OSError, ValueError):
            pass
    if getattr(args, "save_baseline", False):
        json.dump({"date": datetime.date.today().isoformat(), "entries": len(entries),
                   "n": len(ranks), "top3": top3, "topk": topk, "k": args.k,
                   "avg": round(avg, 2)},
                  open(EVAL_BASELINE_PATH, "w", encoding="utf-8"), ensure_ascii=False)
        print(f"基線已存 {os.path.relpath(EVAL_BASELINE_PATH, ROOT)}")
    if worst:
        print("\n掉出 top-3 的（改動後這幾筆變差就是退步）：")
        for r, exp, q in sorted(worst, reverse=True):
            print(f"  rank {r:>3}  {exp}  ←  {q[:40]}…")

    # 檢索吸子：在多個彼此無關的查詢都擠進 top-3 的條目。它不是排序的問題，是那一筆
    # 同時服務太多檢索情境（SRP 違反），而視角越多＝抽獎券越多。**要拆的是條目，不是調參數。**
    attractor = {}
    for (query, expected), qvec in zip(cases, [embed([q]) [0] for q, _ in cases]):
        order = sorted(((best(qvec, vecs[e["relpath"]])[0], e) for e in entries),
                       key=lambda t: -t[0])[:3]
        for _, e in order:
            if e["stem"] not in expected:
                attractor[e["stem"]] = attractor.get(e["stem"], 0) + 1
    noisy = sorted(((c, s) for s, c in attractor.items() if c >= 3), reverse=True)
    if noisy:
        views = {e["stem"]: len(e["views"]) for e in entries}
        print("\n檢索吸子（擠進不相關查詢 top-3 的次數 ≥3）——這是拆分候選，不是調參數的理由：")
        for count, stem in noisy:
            print(f"  {count} 次 / {len(cases)} 題　{stem}（{views[stem]} 個視角）")
    return 0


