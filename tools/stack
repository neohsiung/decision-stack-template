# 可升級區：template 擁有的路徑。upgrade 只覆蓋這些，contribute 只接受這些。
# 與 SHIPPABLE_GLOBS 分開：那一組管「哪些散文要受去個人化檢查」，這一組管
# 「哪些檔案的擁有者是 template」。兩個問題不同，所以兩份清單留著。
# 但受檢範圍取兩者的聯集：會被發布的一定要受檢，這一邊只能大於等於那一邊。
UPGRADABLE_GLOBS = [
    "README.md", "README.en.md", "SPEC.md", "WRITING.md", "examples/*.md", "LICENSE", "CONTRIBUTING.md", "CODE_OF_CONDUCT.md", ".gitignore",
    "tools/stack", "tools/outward-write-guard", "tools/VERSION", "tools/.gitignore",
    "tools/hooks/*", "tools/context/*.md", "tools/context/MANIFEST.tsv",
    "tools/testdata/*/*", "tools/local.example/*", "tools/stack.config.toml.example",
    "templates/*.md", "skills/*/SKILL.md",
    ".github/*.md", ".github/*/*",
]
# 永遠不跨界的東西。列出來是為了讓「為什麼不是可升級區」看得見，不是給程式判斷用的。
PRIVATE_NOTE = ("Models/、Frameworks/、Decisions/、Expressions/、Pending/ 的條目，"
                "MEMORY.md、GLOSSARY.md、tools/local/、tools/stack.config.toml、"
                "tools/regression.tsv")


def upgradable_files():
    import glob
    out = []
    for g in UPGRADABLE_GLOBS:
        for path in sorted(glob.glob(os.path.join(ROOT, g))):
            if os.path.isfile(path):
                out.append(os.path.relpath(path, ROOT))
    return sorted(set(out))


def in_upgradable(rel):
    import fnmatch
    return any(fnmatch.fnmatch(rel, g) for g in UPGRADABLE_GLOBS)


def local_version():
    try:
        return open(VERSION_PATH, encoding="utf-8").read().strip()
    except OSError:
        return "(未知)"


def template_ref(remote, branch):
    """確認 template remote 在、抓得動。回傳 (ref, "")；抓不到回 (None, 原因)。"""
    if git_out("remote", "get-url", remote) is None:
        return None, (f"沒有名為 {remote} 的 remote。先接上 template："
                      f"\n  git remote add {remote} <template repo 的 URL>")
    if git_out("fetch", remote, branch) is None:
        return None, f"git fetch {remote} {branch} 失敗。檢查網路與存取權。"
    ref = f"{remote}/{branch}"
    if git_out("rev-parse", "--verify", ref) is None:
        return None, f"抓到了但解不出 {ref}。"
    return ref, ""


def remote_version(ref):
    out = git_out("show", f"{ref}:tools/VERSION")
    return out.strip() if out else "(未知)"


def cmd_upgrade(args):
    """把 template 的可升級區拉進一條分支。條目一個都不碰。

    整包覆蓋之所以安全，是因為可升級區不含任何內容。不自動合併，走既有的 trunk 閘門。
    """
    ref, why = template_ref(args.remote, args.branch)
    if ref is None:
        die(why)
    print(f"本機工具版本 {local_version()}　template {remote_version(ref)}\n")

    theirs_all = [r for r in (git_out("ls-tree", "-r", "--name-only", ref) or "").split()
                  if in_upgradable(r)]
    changed, added = [], []
    for rel in sorted(set(upgradable_files()) | set(theirs_all)):
        theirs = git_out("show", f"{ref}:{rel}")
        if theirs is None:
            continue                       # template 沒有這個檔，不刪本機的
        try:
            mine = open(os.path.join(ROOT, rel), encoding="utf-8").read()
        except OSError:
            added.append(rel)
            continue
        if mine != theirs:
            changed.append(rel)

    if not changed and not added:
        print("可升級區與 template 一致，沒有要拉的東西。")
        return 0
    for rel in added:
        print(f"  + {rel}（本機沒有）")
    for rel in changed:
        print(f"  ~ {rel}")
    print(f"\n共 {len(changed) + len(added)} 檔。條目、索引、本機區都不在清單裡。")

    if not args.yes:
        print("\n[dry-run] 沒有動任何檔案。要真的拉請加 --yes。")
        return 0
    branch = f"upgrade/{remote_version(ref)}"
    if git_out("rev-parse", "--verify", branch) is not None:
        die(f"分支 {branch} 已存在。先處理掉它，或自己換個名字。")
    if git_out("checkout", "-b", branch) is None:
        die(f"開不了分支 {branch}。\n"
            f"  → 先跑 git status 看工作區有沒有未提交的異動\n"
            f"  → 有的話先 commit 或 stash，再重跑這一支")
    for rel in changed + added:
        if git_out("checkout", ref, "--", rel) is None:
            print(f"  ✗ {rel} 取出失敗")
    print(f"\n✓ 已開 {branch}，{len(changed) + len(added)} 檔取到工作區並 stage，沒有 commit。")
