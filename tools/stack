def cmd_init(args):
    """建立一個新的決策棧。已存在的檔案一律不覆蓋。

    這是唯一在 assert_repo_root 之前跑的子命令：它要建的正是那道檢查要找的目錄。
    """
    made, kept = [], []

    def ensure_dir(rel):
        path = os.path.join(ROOT, rel)
        if os.path.isdir(path):
            kept.append(rel + "/")
        else:
            os.makedirs(path, exist_ok=True)
            open(os.path.join(path, ".gitkeep"), "a").close()
            made.append(rel + "/")

    def ensure_file(rel, content):
        path = os.path.join(ROOT, rel)
        if os.path.exists(path):
            kept.append(rel)
            return
        os.makedirs(os.path.dirname(path) or ROOT, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
        made.append(rel)

    for d in list(SCAN_DIRS) + ["Pending"]:
        ensure_dir(d)
    ensure_file("MEMORY.md", MEMORY_SKELETON)
    ensure_file("GLOSSARY.md", GLOSSARY_SKELETON)

    # 本機區與本機設定：範本進版控，實檔不進
