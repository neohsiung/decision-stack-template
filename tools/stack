# ---------------------------------------------------------------- 讀取與解析

def parse_frontmatter(text):
    """回傳 (frontmatter dict, body)。續行（不是 `key:` 開頭的行）併進前一個鍵。"""
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---\n", 4)
    if end == -1:
        return {}, text
    fm, key = {}, None
    for line in text[4:end].split("\n"):
        m = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if m:
            key = m.group(1)
            fm[key] = m.group(2).strip()
        elif key and line.strip():
            # related 一筆一行，要保留行界；其他欄位是單行值的續行
            sep = "\n" if key == "related" else " "
            fm[key] = (fm[key] + sep + line.strip()) if fm[key] else line.strip()
    return fm, text[end + 5:]


def first_rule(body):
    """正文第一句粗體規則句。repo 慣例保證那就是可遷移的規則。"""
    m = re.search(r"\*\*(.+?)\*\*", body, re.S)
    return re.sub(r"\s+", "", m.group(1)) if m else ""


def entry_links(relpath, body):
    """條目間的相對連結，正規化成 repo 相對路徑。"""
    out, base = [], os.path.dirname(relpath)
    for target in re.findall(r"\]\(([^)]+?\.md)\)", body):
        if target.startswith("http"):
            continue
        norm = os.path.normpath(os.path.join(base, target))
        if norm not in out:
            out.append(norm)
    return out


def strip_related(body):
    """砍掉「相關：」以後的內容——那段講的是別的條目，不是這一筆的主張。"""
    m = re.search(r"\n\s*(?:相關|延伸|參見)[：:]", body)
    return body[:m.start()] if m else body


def strip_section(body, heading):
    """砍掉某個 `## 標題` 到下一個 `## ` 之間的內容，含標題本身。"""
    m = re.search(rf"^##\s+{re.escape(heading)}\s*$", body, re.M)
    if not m:
        return body
    nxt = re.search(r"^##\s+", body[m.end():], re.M)
    return body[:m.start()] + (body[m.end() + nxt.start():] if nxt else "")


def build_views(fm, body, layer=None):
    """回傳 [(kind, text)]。kind 只有 claim 與 body 兩種，用途不同。

    Expressions 只出 claim 視角，不出 body。理由是量出來的：正文裡「寫給誰、寫多長、
    什麼結構」這類句子到處都是，body 視角會在泛用的原則查詢上贏過真正回答那個問題的
    條目。第一次把兩筆 Expression 放進索引，eval 的 recipient-delta 就從 rank 4 掉到 6。

    軸不合成視角。試過把「寫給對上的決定者，走簡報」這種句子放進 claim，結果權責那幾個詞
    撞上責任歸屬的查詢，eval 的 listed-is-not-owner 掉出 top-3。而拿掉合成句之後，兩筆
    Expression 在自己的動作查詢上照樣是第一名。**軸是組織鍵不是檢索鍵**：它管 lint、管索引
    分組、管矩陣看得出哪一格沒填。檢索靠 description，所以 description 要寫出這一格的情境，
    templates/expression.md 有這一條。
    """
    views = []
    desc = fm.get("description", "").strip()
    if desc:
        views.append(("claim", desc))
    rule = first_rule(body)
    if rule:
        views.append(("claim", rule))
    if layer == EXPRESSIONS:
        return views
    for para in re.split(r"\n\s*\n", strip_related(body)):
        text = re.sub(r"\s+", "", re.sub(r"[*`#>]|^\s*[-–]\s*", "", para, flags=re.M))
        if len(text) >= MIN_VIEW_CHARS:
            views.append(("body", text[:MAX_VIEW_CHARS]))
    return views


def parse_related(fm):
    """frontmatter `related:` → [(目標, 分界句)]。一筆一行，格式 `<檔名> — <分界句>`。

    目標可以是 repo 相對路徑、檔名或 stem；lint 用 resolve_entry_ref 解。
    """
    raw = fm.get("related", "").strip()
    if not raw:
        return []
    out = []
    for line in raw.split("\n"):
        line = line.strip().lstrip("-").strip()
        if not line:
            continue
        target, _, note = line.partition(" — ")
        out.append((target.strip(), note.strip()))
    return out


def resolve_entry_ref(ref, live):
    """把 related 的目標寫法解成 repo 相對路徑；解不到回 None。"""
    ref = ref.strip()
    if ref in live:
        return ref
    stem = ref[:-3] if ref.endswith(".md") else ref
    stem = stem.split("/")[-1]
    hits = [p for p in live if p.endswith("/" + stem + ".md")]
    return hits[0] if len(hits) == 1 else None


def entry_sections(body):
    """正文的 `## ` 標題依序回傳。"""
    return [m.strip() for m in re.findall(r"^##\s+(.+?)\s*$", body, re.M)]


def prose_body(body):
    """把一段文字正規化成可以量句子的形狀：去程式碼區塊、表格列、frontmatter。

    density() 與 cmd_prose 共用這一份，兩邊的數字才比得起來。
    """
    text = re.sub(r"```.*?```", "", body, flags=re.S)
    text = "\n".join(l for l in text.splitlines() if not l.lstrip().startswith("|"))
    return re.sub(r"^---.*?---\s*", "", text, flags=re.S)


def prose_sentences(text):
    """切成句子。標題、條列項、表格列各自是一個單位，段落內的硬斷行接回去。

    **這跟 density() 的切法不同，而且是故意的。** density() 先把所有空白拿掉再切句號，
    那對條目成立，因為條目是以句號結尾的散文。留言與訊息大量是條列與標題，不以句號結尾，
    用那個切法整段會被算成一句，量出來的句均會是假的。lint 的密度門檻是照 density()
    校準出來的，所以那一支不動；要量 repo 之外的文字走這一支。
    """
    units, para = [], []
    for line in text.splitlines():
        t = line.strip()
        if not t:
            if para:
                units.append("".join(para)); para = []
            continue
        if re.match(r"^(#{1,6}\s|[-*+]\s|\d+[.)]\s|>|\|)", t):
            if para:
                units.append("".join(para)); para = []
            units.append(re.sub(r"^(#{1,6}\s*|[-*+]\s*|\d+[.)]\s*|>\s*|\|)", "", t))
        else:
            para.append(t)
    if para:
        units.append("".join(para))
    out = []
    for u in units:
        # 中文句號直接切。英文的句點只在「前面是字母、後面是空白或結尾」時才算句末，
        # 這樣 0.39 與 file.md 不會被切開。切之前先切英文，因為去空白之後就判斷不了。
        u = re.sub(r"(?<=[A-Za-z])[.!?](?=\s|$)", "。", u)
        out += [x for x in re.split(r"[。！？]", re.sub(r"\s+", "", u)) if len(x) > 3]
    return out


def prose_stats(body):
    """(句數, 句均字數, 超過 40 字的比例, 句中破折號/千字)。沒有句子時全部回 0。"""
    text = prose_body(body)
    chars = len(re.sub(r"\s+", "", text))
    sents = prose_sentences(text)
    if not sents or chars == 0:
        return 0, 0.0, 0.0, 0.0
    n = 0
    for line in text.splitlines():
        n += re.sub(r"^\s*[-*]\s*\*\*[^*]+\*\*——", "", line.strip()).count("——")
    lens = [len(x) for x in sents]
    return (len(sents), sum(lens) / len(lens),
            sum(1 for x in lens if x > 40) / len(lens) * 100, n / (chars / 1000))


def density(body):
    """(句中破折號/千字, 句均字數)。排除程式碼區塊與表格列。

    只算**句中**破折號。條列項的標籤分隔（`- **某項**——說明`）不算：那是版面，
    校準組保留了它。要刪的是拿破折號當連接詞接第二個意思的用法。
    """
    text = prose_body(body)
    chars = len(re.sub(r"\s+", "", text))
    if chars == 0:
        return 0.0, 0.0
    n = 0
    for line in text.splitlines():
        n += re.sub(r"^\s*[-*]\s*\*\*[^*]+\*\*——", "", line.strip()).count("——")
    sents = [x for x in re.split(r"[。！？]", re.sub(r"\s+", "", text)) if len(x) > 3]
    avg = (sum(map(len, sents)) / len(sents)) if sents else 0.0
    return n / (chars / 1000), avg


# 可機械檢查的 AI 語標記。WRITING §句子 列了五樣，這裡只收正規表示式抓得準的兩樣。
#
# 對仗式收尾與名詞化主語不收。兩者都要判斷句子的語意角色，正規表示式做不到，硬做會製造
# 大量誤判，而誤判會讓整組提醒一起被忽略。它們留在 README 的散文規則裡靠人讀，**是刻意
# 不做，不是漏掉**。
#
# 粗體宣告密度也還沒收：門檻要從校準組量出來，而校準組裡沒有 Expression。等第二批寫完再量。
# 「不是X是Y」這一條是**提示不是判決**。這個句型有兩種用法，正規表示式分不出來：
# 對比本身就是主張時要留（「上游層的時間不是成本，是保險」「說不出基準的決策不是判斷，
# 是意見」），這個 repo 的檔名就是這個形式，WRITING §命名 明寫那是索引設計。對比只是修辭時
# 才刪（「寫不下不是加長的理由，是判斷還沒收斂」，正面講一次就夠）。
# 實測：某次盤點 Models 撈到八處，七處是主張本身，只有一處是裝飾。所以看到數字不要直接去清。
AI_TELLS = [
    (re.compile(r"不是[^。；\n]{1,24}(?:[，、]\s*是|而是)"), "不是X是Y"),
    # 只收「前者」「後者」。WRITING §對照其他條目 禁的是四個詞，另外兩個收不乾淨：
    #   「基本條件」裡面包著「本條」，要求前面不接中文字才排除得掉；
    #   但「那條規則指名的關卡」與「那條已經從本檔拆出去」都在句首，前者是名詞短語、
    #   後者是回指，差別在後面接名詞還是動詞。那是詞性判斷，正規表示式做不到。
    # 硬收的話偽陽性會多到讓整組提醒被忽略。「本條」「那條」交給人讀，而 related: 欄位
    # 那一側本來就由格式檢查擋著。
    (re.compile(r"前者|後者"), "回指詞"),
    # 自造比喻。WRITING §句子 列的詞裡只收這兩個，其餘量過之後確定是偽陽性機器：
    #   「漏」60 次全是中文常用義（漏了驗證階段、必漏上限），「形狀」65 次已經是全庫
    #   採用的術語，跟「閘門」「骨架」同類。把它們列進來會擋掉正確的寫法。
    # 這兩個不一樣：替代詞明確（不產生訊號、檢查失敗），而且量出來只有 15 處。
    (re.compile(r"靜默|亮紅燈"), "自造比喻"),
]

# 刻意不做成檢查的，連同理由記在這裡，免得下一輪有人以為是漏掉的：
#   對仗式收尾、標語式宣告、情緒鋪陳、一句一意、why/what/how 分類、抽象名詞當主語、
#   還沒驗證要寫成還沒驗證 —— 全部要判斷語意角色，正規表示式做不到。
#   括號補充 —— 量過一批真實留言，63 處幾乎全是識別碼與引用。
#   被X者造詞式角色名 —— 只有 6 處真陽性，而且會誤傷受控詞彙「被知會者」。
#   空節偵測 —— 現況 0 個空節，沒有要防的東西。
#   recorded 不回填、拆檔沿用母條目 —— 沒有可比對的事實。


def ai_tells(body):
    """回傳 [(標記名, 次數)]。排除程式碼區塊與 frontmatter。"""
    text = re.sub(r"```.*?```", "", body, flags=re.S)
    text = re.sub(r"^---.*?---\s*", "", text, flags=re.S)
    out = []
    for pat, name in AI_TELLS:
        n = len(pat.findall(text))
        if n:
            out.append((name, n))
    return out


def parse_upstream(fm):
    """frontmatter `upstream:` → repo 相對路徑清單（逗號分隔、可多筆＝多對多）。"""
    raw = fm.get("upstream", "").strip()
    if not raw:
        return []
    return [os.path.normpath(p.strip()) for p in raw.split(",") if p.strip()]


def assert_repo_root():
    """ROOT 必須真的是一個決策棧 repo，否則明確失敗。

    沒有這道檢查，ROOT 算錯的結果是 recall 印出「決策棧檢索：命中」後面空白、exit 0。
    看起來像這次沒有相關條目，實際是沒找到 repo。兩件事要做的處置完全不同。
    """
    missing = [d for d in LAYERS if not os.path.isdir(os.path.join(ROOT, d))]
    if len(missing) != len(LAYERS):
        return
    # 剛從 template clone 下來的樣子：工具在、模板在、條目目錄還沒建。這種情況
    # 答案是「還沒跑 init」，不是路徑推導壞掉。兩者的處置完全不同，訊息要分開。
    if os.path.isdir(os.path.join(ROOT, "templates")) and \
       os.path.isfile(os.path.join(ROOT, "tools", "VERSION")):
        die(f"{ROOT} 看起來是剛 clone 下來、還沒初始化的模板。"
            f"\n  先跑：{os.path.relpath(os.path.realpath(__file__), ROOT)} init"
            f"\n  它會建 {'／'.join(LAYERS)}、Expressions/、Pending/ 與 MEMORY.md。")
    die(f"{ROOT} 不是決策棧 repo，找不到 {'／'.join(LAYERS)} 任何一個。"
        f"\n  這支腳本從自身位置推導 repo root。經 symlink 呼叫而推導失敗會落在這裡。"
        f"\n  → 確認 {os.path.realpath(__file__)} 落在 repo 的 tools/ 底下"
        f"\n  → 接線壞掉時重跑：<repo>/tools/stack install --yes")


def load_entries():
    entries = []
    for layer in SCAN_DIRS:
        d = os.path.join(ROOT, layer)
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".md"):
                continue
            relpath = f"{layer}/{fn}"
            with open(os.path.join(d, fn), encoding="utf-8") as f:
                text = f.read()
            fm, body = parse_frontmatter(text)
            views = build_views(fm, body, layer)
            upstream = parse_upstream(fm)
            links = entry_links(relpath, body)
            related = parse_related(fm)
            entries.append({
                "relpath": relpath,
                "layer": layer,
                "stem": fn[:-3],
                "fm": fm,
                "body": body,
                "upstream": upstream,
                "related": related,
                # upstream 也餵進 links：recall 的一跳鄰居沿它展開，族譜關係就是檢索路徑。
                # related 的目標在 load 後解析（要先知道全部路徑），見下方補接。
                "links": links + [u for u in upstream if u not in links],
                "views": views,
                "hash": hashlib.sha256("\x00".join(t for _, t in views).encode()).hexdigest()[:16],
            })
    # related 目標補進 links：「相關：」從正文搬到 frontmatter 後，一跳鄰居不能因此變少
    live = {e["relpath"] for e in entries}
    for e in entries:
        for target, _ in e["related"]:
            r = resolve_entry_ref(target, live)
            if r and r not in e["links"]:
                e["links"].append(r)
    return entries


def unreviewed_paths():
    """尚未進入已審 trunk（origin/main）的條目路徑。

    push 閘門守的是「內容有沒有外流」，但一條原則**生效的時點是它被檢索到**，而檢索讀的是
    工作目錄不是 origin/main。所以寫完的當下它就已經在影響判斷了，而且完全靜默——這正是
    Decisions/source-migration-downstream-drift.md 講的那種失效，只是換到了審查這條軸上。

    修法不是禁止使用（同一輪寫下的原則本來就該當輪拿來用），是**讓它不靜默**：撈出來時標
    〔未審〕，引用它的人就知道這條還沒有人看過。
    """
    try:
        ahead = subprocess.run(["git", "-C", ROOT, "diff", "--name-only", "origin/main...HEAD"],
                               capture_output=True, text=True, timeout=10)
        dirty = subprocess.run(["git", "-C", ROOT, "status", "--porcelain"],
                               capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return set()          # 不是 git repo 或沒有 origin/main：不標記，不要假裝知道
    if ahead.returncode != 0:
        return set()
    paths = set(ahead.stdout.split())
    paths |= {ln[3:].strip().strip('"') for ln in dirty.stdout.splitlines() if ln[3:].strip()}
    return paths


def git_out(*args):
    """跑 git，失敗回 None（不是 git repo、或 git 不在都算失敗，不讓檢索掛掉）。"""
    try:
        r = subprocess.run(["git", "-C", ROOT, *args],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


# recall 讀工作目錄，lint／tree／eval 量工作目錄。工作目錄飄掉的時候這幾個數字
# 全部不可比，而現有的檢查一道都不會因此變紅——那正是不產生訊號的缺陷入口。
DRIFT_WATCHED = ("recall", "shape", "lint", "tree", "eval")


def baseline_drift():
    """工作目錄與 origin/main 的落差。回一串要印的話，沒事回空 list。

    它問的是「工作目錄是不是在你以為的位置」，不問「條目內容對不對」。所以這一項
    不報不代表 eval 的數字可比，只代表基準沒飄。

    只比可數的事實，不做判斷：HEAD 指到哪、本機 main 與 origin/main 差幾個 commit、
    當前分支的基準是不是 origin/main。三者都沒有偽陽性空間。查詢句是不是動作句、
    這一輪該不該寫條目那種要語意判斷的，一律不收，理由見
    guard-must-cover-every-writer 的「偽陽性太多時收窄適用範圍」。

    兩個刻意的設計：

    - **雙向比，不只比落後。** 本機 main 領先 origin/main 代表有 commit 沒推出去，
      別的 session 看不到它，照樣會從一個不完整的基準開分支。只查落後會漏掉這一邊。
    - **在分支上本身不報。** write-procedure step 7 要求寫入一律走分支，把「HEAD 不在
      main」報成異常等於要求人去做流程還沒輪到的事。報的是基準過期，跟在不在分支上無關。
    """
    if not git_out("rev-parse", "--verify", "--quiet", "refs/remotes/origin/main"):
        return []                      # 沒有設 origin，或還沒 fetch 過
    msgs = []

    head = git_out("symbolic-ref", "--short", "-q", "HEAD")
    head = head.strip() if head else None
    if head is None:
        msgs.append("HEAD 是 detached，工作目錄不屬於任何分支")

    counts = git_out("rev-list", "--left-right", "--count", "main...origin/main")
    if counts and len(counts.split()) == 2:
        ahead, behind = (int(x) for x in counts.split())
        if behind:
            msgs.append(f"本機 main 落後 origin/main {behind} 個 commit，"
                        f"拿它開的分支基準是舊的")
        if ahead:
            msgs.append(f"本機 main 領先 origin/main {ahead} 個 commit，"
                        f"有東西還沒推出去，別的 session 看不到")

    if head and head != "main":
        base = git_out("merge-base", "HEAD", "origin/main")
        tip = git_out("rev-parse", "origin/main")
        if base and tip and base.strip() != tip.strip():
            n = git_out("rev-list", "--count", "HEAD..origin/main")
            msgs.append(f"分支 {head} 的基準比 origin/main 舊 "
                        f"{n.strip() if n else '?'} 個 commit")
    return msgs


def unmerged_branches(base="main"):
    out = git_out("branch", "--no-merged", base, "--format=%(refname:short)")
    if out is None:
        return []
    return [b.strip() for b in out.splitlines() if b.strip()]


def load_branch_entries(working):
    """未合併分支上的條目。

    存在的理由：`recall` 只讀工作目錄，所以一條原則寫進自己的分支之後，就從後續
    dedupe 的視野裡消失了——正是 dedupe 要防的事。內容與工作目錄相同的略過（沒有
    新資訊），只回傳「這個分支上才有」或「這個分支上長得不一樣」的那些。
    """
    seen = {e["hash"] for e in working}
    entries = []
    for br in unmerged_branches():
        listing = git_out("ls-tree", "-r", "--name-only", br, "--", *SCAN_DIRS)
        if not listing:
            continue
        for relpath in listing.splitlines():
            relpath = relpath.strip()
            if not relpath.endswith(".md"):
                continue
            layer = relpath.split("/", 1)[0]
            if layer not in SCAN_DIRS:
                continue
            text = git_out("show", f"{br}:{relpath}")
            if text is None:
                continue
            fm, body = parse_frontmatter(text)
            views = build_views(fm, body, layer)
            h = hashlib.sha256("\x00".join(x for _, x in views).encode()).hexdigest()[:16]
            if h in seen:
                continue          # 與工作目錄同內容，不重複計入
            seen.add(h)
            entries.append({
                "relpath": f"{relpath}@{br}",
                "layer": layer,
                "stem": os.path.basename(relpath)[:-3],
                "fm": fm,
                "body": body,
                "links": [],      # 分支上的連結可能指到尚不存在的檔案，不參與鄰居展開
                "upstream": [],
                "views": views,
                "hash": h,
                "branch": br,
            })
    return entries


def memory_index_paths():
    if not os.path.exists(MEMORY_PATH):
        return []
    with open(MEMORY_PATH, encoding="utf-8") as f:
        return re.findall(
            r"\]\((Models/[^)]+\.md|Decisions/[^)]+\.md|Frameworks/[^)]+\.md"
            r"|Expressions/[^)]+\.md)\)", f.read())


# ---------------------------------------------------------------- 詞彙表

GLOSSARY_PATH = os.path.join(ROOT, "GLOSSARY.md")


def github_anchor(heading):
    """GitHub 式錨點：小寫、去標點、空白轉連字號。詞彙表標題慣例是 ASCII 術語本名。"""
    h = re.sub(r"[^\w一-鿿 ]", "", heading.strip().lower())
    return h.replace(" ", "-")


def glossary_sections():
    """回傳 {anchor: {"term", "backrefs"}}。backrefs 取自各節的「棧內引用」行。"""
    if not os.path.exists(GLOSSARY_PATH):
        return {}
    sections, current = {}, None
    with open(GLOSSARY_PATH, encoding="utf-8") as f:
        text = f.read()
    # HTML 註解裡的內容不算術語。骨架的格式範例住在註解裡，
    # 不跳過的話它會變成一個沒有反向引用的幽靈術語，而空棧第一次 lint 就紅
    for line in re.sub(r"<!--.*?-->", "", text, flags=re.S).splitlines(True):
        if True:
            m = re.match(r"^## (.+)$", line)
            if m:
                current = github_anchor(m.group(1))
                sections[current] = {"term": m.group(1).strip(), "backrefs": []}
            elif current and line.startswith("棧內引用"):
                sections[current]["backrefs"] = [
                    os.path.normpath(t) for t in re.findall(r"\]\(([^)#]+)\)", line)]
    return sections


def glossary_usages():
    """全 repo 指向 GLOSSARY.md#錨點 的連結：{anchor: set(repo 相對路徑)}。"""
    usages = {}
    files = [("README.md", os.path.join(ROOT, "README.md"))]
    # tools/context/ 的片段是保證載入通道的正本，判準會從 README 搬進去，
    # 所以詞彙表的雙向檢查要看得到它——看不到的那一側會靜默漂移。
    ctx = os.path.join(ROOT, "tools", "context")
    if os.path.isdir(ctx):
        files += [(f"tools/context/{fn}", os.path.join(ctx, fn))
                  for fn in sorted(os.listdir(ctx)) if fn.endswith(".md")]
    for layer in SCAN_DIRS:
        d = os.path.join(ROOT, layer)
        if not os.path.isdir(d):
            continue
        files += [(f"{layer}/{fn}", os.path.join(d, fn))
                  for fn in sorted(os.listdir(d)) if fn.endswith(".md")]
    for relpath, path in files:
        # 檔案不在就跳過。剛 init 的棧還沒有 README.md，那不是缺陷
        try:
            with open(path, encoding="utf-8") as f:
                text = f.read()
        except OSError:
            continue
        for anchor in re.findall(r"\]\((?:\.\./)*GLOSSARY\.md#([\w一-鿿-]+)\)", text):
            usages.setdefault(anchor, set()).add(relpath)
    return usages


# ---------------------------------------------------------------- 向量

def embed(texts):
    payload = json.dumps({"model": EMBED_MODEL, "input": texts}).encode()
    req = urllib.request.Request(
        f"{OLLAMA_URL}/api/embed", data=payload, headers={"Content-Type": "application/json"})
    try:
        data = json.load(urllib.request.urlopen(req, timeout=EMBED_TIMEOUT))
    except (urllib.error.URLError, OSError) as e:
        die(f"連不上 Ollama（{OLLAMA_URL}）：{e}\n"
            f"  → 檢索降級：改讀 MEMORY.md（功能降級但不失效）\n"
            f"  → 恢復方式：ollama serve；模型未安裝時 ollama pull {EMBED_MODEL}")
    vectors = data.get("embeddings")
    if not vectors:
        die(f"Ollama 有回應但沒有 embeddings 欄位：{json.dumps(data)[:200]}\n"
            f"  這通常代表 {EMBED_MODEL} 沒裝或裝壞了。\n"
            f"  → 先跑：ollama pull {EMBED_MODEL}\n"
            f"  → 仍失敗就改讀 MEMORY.md，檢索降級但不失效")
    return [normalize(v) for v in vectors]


def normalize(v):
    n = math.sqrt(sum(x * x for x in v)) or 1.0
    return [x / n for x in v]


def dot(a, b):
    return sum(x * y for x, y in zip(a, b))


def pack(vec):
    return base64.b64encode(array.array("f", vec).tobytes()).decode()


def unpack(blob):
    a = array.array("f")
    a.frombytes(base64.b64decode(blob))
    return a


def ensure_index(entries, force=False, verbose=True, index_path=None):
    """回傳 relpath -> [(kind, vec)]。只重嵌內容雜湊變了的條目。"""
    idx = {"model": EMBED_MODEL, "entries": {}}
    index_path = index_path or INDEX_PATH
    if os.path.exists(index_path) and not force:
        try:
            with open(index_path, encoding="utf-8") as f:
                loaded = json.load(f)
            if loaded.get("model") == EMBED_MODEL and loaded.get("schema") == 2:
                idx = loaded
        except (json.JSONDecodeError, OSError):
            pass  # 索引壞掉就整份重建，它是純衍生物
    idx["schema"] = 2

    cached = idx["entries"]
    stale = [e for e in entries if cached.get(e["relpath"], {}).get("hash") != e["hash"]]
    if stale:
        if verbose:
            what = "建立索引" if len(stale) == len(entries) else "索引過期，重嵌"
            n_views = sum(len(e["views"]) for e in stale)
            print(f"[{what} {len(stale)}/{len(entries)} 筆、{n_views} 個視角]", file=sys.stderr)
        flat = [(e, k, t) for e in stale for k, t in e["views"]]
        for i in range(0, len(flat), 24):
            chunk = flat[i:i + 24]
            for (e, kind, _), vec in zip(chunk, embed([t for _, _, t in chunk])):
                slot = cached.setdefault(e["relpath"], {"hash": e["hash"], "views": []})
                if slot.get("hash") != e["hash"]:
                    slot.update({"hash": e["hash"], "views": []})
                slot["views"].append([kind, pack(vec)])

    live = {e["relpath"] for e in entries}
    for gone in [p for p in cached if p not in live]:
        del cached[gone]

    if stale or force:
        os.makedirs(os.path.dirname(index_path), exist_ok=True)
        with open(index_path, "w", encoding="utf-8") as f:
            json.dump(idx, f)
    return {p: [(k, unpack(b)) for k, b in v["views"]] for p, v in cached.items()}


def best(qvec, views, kinds=None):
    """max-pool：回傳 (最高相似度, 命中的視角 kind)。串接會稀釋，取最大值不會。"""
    cand = [(dot(qvec, v), k) for k, v in views if kinds is None or k in kinds]
    return max(cand) if cand else (0.0, "")


